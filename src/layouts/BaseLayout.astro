---
import Seo from '@components/seo/Seo.astro';
import Header from '@components/layout/Header.astro';
import Footer from '@components/layout/Footer.astro';
import CookieConsent from '@components/cookie/CookieConsent.astro';
import { organizationSchema, ferramentaSchema, websiteSchema, breadcrumbSchema } from '@lib/schema';
import '@styles/global.css';

interface Props {
  title: string;
  description: string;
  path: string;
  image?: string;
  noindex?: boolean;
  breadcrumbs?: { name: string; url: string }[];
  jsonLd?: Record<string, unknown>[];
}

const { title, description, path, image, noindex, breadcrumbs, jsonLd = [] } = Astro.props;

const structuredData = [
  organizationSchema(),
  ferramentaSchema(),
  websiteSchema(),
  ...(breadcrumbs ? [breadcrumbSchema(breadcrumbs)] : []),
  ...jsonLd,
];
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="format-detection" content="telephone=no" />
    <Seo title={title} description={description} path={path} image={image} noindex={noindex} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-48.png" sizes="48x48" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#1c5d90" />

    <!-- Font self-hosted: nessuna richiesta a server di terze parti -->
    <link rel="preload" href="/fonts/bricolage-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/figtree-latin.woff2" as="font" type="font/woff2" crossorigin />

    {structuredData.map((schema) => <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />)}
  </head>
  <body>
    <a href="#contenuto" class="skip-link">Vai al contenuto principale</a>
    <Header />
    <main id="contenuto">
      <slot />
    </main>
    <Footer />
    <CookieConsent />

    <script>
      import '../scripts/reveal.ts';
    </script>
  </body>
</html>
