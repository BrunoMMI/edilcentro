---
interface Props {
  title: string;
  updated: string;
}

const { title, updated } = Astro.props;
---

<article class="legal">
  <div class="container legal__inner">
    <header class="legal__header" data-reveal>
      <h1>{title}</h1>
      <p class="legal__updated">Ultimo aggiornamento: {updated}</p>
    </header>
    <div class="legal__body" data-reveal data-reveal-index="1">
      <slot />
    </div>
  </div>
</article>

<style>
  .legal {
    padding-block: var(--space-2xl);
  }

  .legal__inner {
    max-width: 48rem;
  }

  .legal__header {
    margin-bottom: var(--space-xl);
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--color-border);
  }

  .legal__updated {
    color: var(--color-ink-faint);
    font-size: 0.875rem;
    margin-top: var(--space-2xs);
  }

  .legal__body :global(h2) {
    font-size: 1.375rem;
    margin-top: var(--space-xl);
    margin-bottom: var(--space-sm);
  }

  .legal__body :global(h2:first-child) {
    margin-top: 0;
  }

  .legal__body :global(p) {
    margin-bottom: var(--space-sm);
  }

  .legal__body :global(ul) {
    margin-bottom: var(--space-sm);
    padding-left: 1.2rem;
    list-style: disc;
  }

  .legal__body :global(li) {
    color: var(--color-ink-soft);
    margin-bottom: 0.4em;
  }

  .legal__body :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .legal__body :global(.legal-note) {
    background: var(--color-accent-light);
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-sm);
    padding: var(--space-sm) var(--space-md);
    font-size: 0.9375rem;
    color: var(--color-accent-dark);
    margin-block: var(--space-md);
  }

  .legal__body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-block: var(--space-sm) var(--space-md);
    font-size: 0.875rem;
  }

  .legal__body :global(th),
  .legal__body :global(td) {
    text-align: left;
    padding: 0.6em 0.8em;
    border: 1px solid var(--color-border);
  }

  .legal__body :global(th) {
    background: var(--color-paper-alt);
  }
</style>
