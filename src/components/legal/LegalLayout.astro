---
import Breadcrumbs from '@components/ui/Breadcrumbs.astro';

interface Props {
  title: string;
  updated: string;
  breadcrumbs: { name: string; url: string }[];
}

const { title, updated, breadcrumbs } = Astro.props;
---

<article class="legal">
  <div class="container legal__inner">
    <header class="legal__header">
      <Breadcrumbs items={breadcrumbs} />
      <h1>{title}</h1>
      <p class="legal__updated">Ultimo aggiornamento: {updated}</p>
    </header>
    <div class="legal__body">
      <slot />
    </div>
  </div>
</article>

<style>
  .legal {
    padding-block: var(--space-lg) var(--space-2xl);
  }

  .legal__inner {
    max-width: 50rem;
  }

  .legal__header {
    margin-bottom: var(--space-lg);
    padding-bottom: var(--space-md);
    border-bottom: 1px solid var(--color-border-strong);
  }

  .legal__header h1 {
    margin-top: var(--space-md);
    font-size: clamp(2.25rem, 5vw, 3.5rem);
  }

  .legal__updated {
    color: var(--color-ink-faint);
    margin-top: var(--space-xs);
  }

  .legal__body {
    background: var(--color-surface);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-sm);
    padding: clamp(1.25rem, 4vw, 3rem);
  }

  .legal__body :global(h2) {
    font-size: 1.5rem;
    margin-top: var(--space-lg);
    margin-bottom: var(--space-xs);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
  }

  .legal__body :global(h2:first-child),
  .legal__body :global(.legal-note + h2) {
    margin-top: 0;
  }

  .legal__body :global(h2:first-child) {
    padding-top: 0;
    border-top: 0;
  }

  .legal__body :global(p) {
    margin-bottom: var(--space-sm);
    max-width: 70ch;
  }

  .legal__body :global(ul) {
    margin-bottom: var(--space-sm);
    padding-left: 1.2rem;
    list-style: disc;
  }

  .legal__body :global(li) {
    color: var(--color-ink-soft);
    margin-bottom: 0.4em;
  }

  .legal__body :global(a) {
    color: var(--color-primary);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .legal__body :global(.legal-note) {
    background: var(--color-accent-light);
    border-radius: var(--radius-md);
    padding: var(--space-sm) var(--space-md);
    color: var(--color-ink);
    margin-block: 0 var(--space-md);
    max-width: none;
  }

  .legal__body :global(.table-wrap) {
    overflow-x: auto;
    margin-block: var(--space-xs) var(--space-md);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .legal__body :global(table) {
    width: 100%;
    min-width: 36rem;
    font-size: 0.9375rem;
  }

  .legal__body :global(th),
  .legal__body :global(td) {
    text-align: left;
    vertical-align: top;
    padding: 0.7em 0.9em;
    border-bottom: 1px solid var(--color-border);
  }

  .legal__body :global(th) {
    background: var(--color-primary-light);
    color: var(--color-primary-dark);
  }

  .legal__body :global(tbody tr:last-child td) {
    border-bottom: 0;
  }

  .legal__body :global(.legal-actions) {
    margin-block: var(--space-sm);
  }

  .legal__body :global(.legal-actions .btn) {
    text-decoration: none;
    color: #fff;
  }
</style>
