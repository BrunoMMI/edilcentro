---
import { cookieCategories } from '@data/cookie-categories';
---

<div class="cookie-banner" data-cookie-banner role="region" aria-label="Informativa cookie" hidden>
  <div class="cookie-banner__inner">
    <p>
      Utilizziamo solo cookie tecnici necessari al funzionamento del sito. Non utilizziamo cookie di analisi o
      marketing. Puoi consultare la nostra <a href="/cookie-policy/">Cookie Policy</a> per maggiori dettagli.
    </p>
    <div class="cookie-banner__actions">
      <button type="button" class="btn btn-secondary btn-sm" data-cookie-reject>Rifiuta non necessari</button>
      <button type="button" class="btn btn-secondary btn-sm" data-cookie-customize>Personalizza</button>
      <button type="button" class="btn btn-primary btn-sm" data-cookie-accept-all>Accetta tutti</button>
    </div>
  </div>
</div>

<dialog class="cookie-dialog" data-cookie-dialog aria-labelledby="cookie-dialog-title">
  <form method="dialog" class="cookie-dialog__form">
    <div class="cookie-dialog__header">
      <h2 id="cookie-dialog-title">Preferenze cookie</h2>
      <button type="button" class="cookie-dialog__close" data-cookie-dialog-close aria-label="Chiudi">
        &times;
      </button>
    </div>
    <p>
      Gestisci le categorie di cookie utilizzate su questo sito. I cookie necessari sono sempre attivi perché
      indispensabili al funzionamento del sito.
    </p>
    <ul class="cookie-dialog__list">
      {
        cookieCategories.map((category) => (
          <li>
            <div class="cookie-dialog__item-head">
              <label>
                <input
                  type="checkbox"
                  data-cookie-toggle={category.slug}
                  checked={category.required}
                  disabled={category.required}
                />
                <span>{category.title}</span>
              </label>
              {category.required && <span class="cookie-dialog__badge">Sempre attivi</span>}
            </div>
            <p>{category.description}</p>
          </li>
        ))
      }
    </ul>
    <div class="cookie-dialog__actions">
      <button type="button" class="btn btn-secondary btn-sm" data-cookie-accept-all>Accetta tutti</button>
      <button type="button" class="btn btn-primary btn-sm" data-cookie-save>Salva preferenze</button>
    </div>
  </form>
</dialog>

<script>
  import '../../scripts/cookie-consent.ts';
</script>

<style>
  .cookie-banner {
    position: fixed;
    left: var(--space-sm);
    right: var(--space-sm);
    bottom: var(--space-sm);
    z-index: 300;
    max-width: 680px;
    margin-inline: auto;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
    padding: var(--space-md);
  }

  .cookie-banner__inner p {
    font-size: 0.875rem;
    color: var(--color-ink-soft);
    margin-bottom: var(--space-sm);
  }

  .cookie-banner__inner a {
    text-decoration: underline;
    color: var(--color-primary);
  }

  .cookie-banner__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6em;
  }

  .cookie-dialog {
    border: none;
    border-radius: var(--radius-lg);
    padding: 0;
    width: min(560px, 92vw);
    box-shadow: var(--shadow-lg);
  }

  .cookie-dialog::backdrop {
    background: rgba(32, 29, 25, 0.55);
    backdrop-filter: blur(2px);
  }

  .cookie-dialog__form {
    padding: var(--space-lg);
  }

  .cookie-dialog__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-sm);
  }

  .cookie-dialog__close {
    font-size: 1.5rem;
    line-height: 1;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-full);
  }

  .cookie-dialog__close:hover {
    background: var(--color-paper-alt);
  }

  .cookie-dialog__form > p {
    font-size: 0.9375rem;
    margin-bottom: var(--space-md);
  }

  .cookie-dialog__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .cookie-dialog__list li {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: var(--space-sm);
  }

  .cookie-dialog__item-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.35em;
  }

  .cookie-dialog__item-head label {
    display: flex;
    align-items: center;
    gap: 0.6em;
    font-weight: 600;
  }

  .cookie-dialog__badge {
    font-size: 0.75rem;
    color: var(--color-accent-dark);
    background: var(--color-accent-light);
    padding: 0.2em 0.6em;
    border-radius: var(--radius-full);
  }

  .cookie-dialog__list p {
    font-size: 0.875rem;
    color: var(--color-ink-soft);
  }

  .cookie-dialog__actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.6em;
  }

  @media (max-width: 480px) {
    .cookie-banner__actions {
      flex-direction: column;
    }

    .cookie-banner__actions .btn {
      width: 100%;
    }
  }
</style>
