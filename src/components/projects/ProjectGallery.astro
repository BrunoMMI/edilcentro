---
import { Image } from 'astro:assets';
import { getImage } from 'astro:assets';
import { projectImages, projectStyles } from '@data/projects';

const fullSizes = await Promise.all(
  projectImages.map((item) => getImage({ src: item.image, width: 1400, format: 'webp' })),
);
---

<div class="gallery-filters" role="group" aria-label="Filtra i progetti per stile">
  <button type="button" data-gallery-filter="all" aria-pressed="true">Tutti</button>
  {
    projectStyles.map((style) => (
      <button type="button" data-gallery-filter={style.slug} aria-pressed="false">
        {style.label}
      </button>
    ))
  }
</div>

<div class="gallery-grid" data-gallery>
  {
    projectImages.map((item, index) => (
      <button
        type="button"
        class="gallery-item"
        data-gallery-item
        data-style={item.style}
        data-full={fullSizes[index].src}
        data-alt={item.alt}
        data-reveal
        data-reveal-index={index % 6}
      >
        <Image src={item.image} alt={item.alt} widths={[320, 480]} sizes="(max-width: 640px) 45vw, 22vw" loading={index < 6 ? 'eager' : 'lazy'} />
      </button>
    ))
  }
</div>

<dialog class="lightbox" data-lightbox aria-label="Anteprima immagine progetto">
  <button type="button" class="lightbox__close" data-lightbox-close aria-label="Chiudi anteprima">&times;</button>
  <button type="button" class="lightbox__nav lightbox__nav--prev" data-lightbox-prev aria-label="Immagine precedente">
    &#8592;
  </button>
  <figure>
    <img data-lightbox-img src="" alt="" />
    <figcaption data-lightbox-caption></figcaption>
  </figure>
  <button type="button" class="lightbox__nav lightbox__nav--next" data-lightbox-next aria-label="Immagine successiva">
    &#8594;
  </button>
</dialog>

<script>
  import '../../scripts/gallery.ts';
</script>

<style>
  .gallery-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6em;
    margin-bottom: var(--space-lg);
  }

  .gallery-filters button {
    padding: 0.55em 1.1em;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border-strong);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-ink-soft);
    transition: background-color var(--transition-base), color var(--transition-base), border-color var(--transition-base);
  }

  .gallery-filters button[aria-pressed='true'] {
    background: var(--color-primary-dark);
    border-color: var(--color-primary-dark);
    color: #fff;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-sm);
  }

  .gallery-item {
    display: block;
    border-radius: var(--radius-md);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    position: relative;
  }

  .gallery-item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .gallery-item:hover :global(img) {
    transform: scale(1.06);
  }

  @media (max-width: 900px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .lightbox {
    border: none;
    background: transparent;
    max-width: 92vw;
    max-height: 92vh;
    padding: 0;
  }

  .lightbox::backdrop {
    background: rgba(15, 13, 11, 0.92);
  }

  .lightbox figure {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
  }

  .lightbox img {
    max-width: 88vw;
    max-height: 80vh;
    width: auto;
    border-radius: var(--radius-sm);
    object-fit: contain;
  }

  .lightbox figcaption {
    color: rgba(255, 255, 255, 0.75);
    font-size: 0.875rem;
    text-align: center;
    max-width: 60ch;
  }

  .lightbox__close {
    position: fixed;
    top: var(--space-md);
    right: var(--space-md);
    width: 44px;
    height: 44px;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    font-size: 1.75rem;
    line-height: 1;
  }

  .lightbox__nav {
    position: fixed;
    top: 50%;
    transform: translateY(-50%);
    width: 48px;
    height: 48px;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    font-size: 1.25rem;
    display: grid;
    place-items: center;
  }

  .lightbox__nav:hover,
  .lightbox__close:hover {
    background: rgba(255, 255, 255, 0.22);
  }

  .lightbox__nav--prev {
    left: var(--space-md);
  }

  .lightbox__nav--next {
    right: var(--space-md);
  }
</style>
