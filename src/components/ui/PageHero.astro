---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Breadcrumbs from '@components/ui/Breadcrumbs.astro';

interface Props {
  title: string;
  subtitle?: string;
  breadcrumbs: { name: string; url: string }[];
  image?: ImageMetadata;
  imageAlt?: string;
}

const { title, subtitle, breadcrumbs, image, imageAlt = '' } = Astro.props;
---

<section class:list={['page-hero', { 'page-hero--photo': image }]}>
  <div class="container page-hero__grid">
    <div class="page-hero__copy">
      <Breadcrumbs items={breadcrumbs} light={Boolean(image)} />
      <h1>{title}</h1>
      {subtitle && <p class="lede">{subtitle}</p>}
    </div>
    {
      image && (
        <div class="page-hero__photo">
          <Image
            src={image}
            alt={imageAlt}
            widths={[480, 720, 1000]}
            sizes="(max-width: 900px) 100vw, 46vw"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      )
    }
  </div>
</section>

<style>
  .page-hero {
    padding-block: var(--space-lg) var(--space-xl);
    margin: var(--space-xs) var(--panel-inset) 0;
    border-radius: var(--radius-xl);
    background:
      radial-gradient(circle at 100% 0%, rgba(0, 152, 69, 0.14), transparent 40%),
      radial-gradient(circle at 0% 100%, rgba(28, 93, 144, 0.12), transparent 45%),
      var(--color-paper-alt);
  }

  .page-hero__copy h1 {
    margin-top: var(--space-md);
    max-width: 18ch;
  }

  .page-hero__copy .lede {
    margin-top: var(--space-sm);
    max-width: 52ch;
  }

  /* Variante con fotografia: pannello blu morbido + foto ad angoli opposti */
  .page-hero--photo {
    padding: 0;
    margin: var(--space-xs) 0 0;
    border-radius: 0;
    background: none;
  }

  .page-hero--photo .page-hero__grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: var(--grout);
  }

  .page-hero--photo .page-hero__copy {
    padding: clamp(1.75rem, 5vw, 4rem);
    align-self: stretch;
    display: flex;
    flex-direction: column;
    justify-content: center;
    border-radius: var(--radius-xl);
    background:
      radial-gradient(circle at 95% 5%, rgba(0, 152, 69, 0.45), transparent 45%),
      radial-gradient(circle at 0% 100%, rgba(28, 93, 144, 0.65), transparent 55%),
      var(--color-primary-dark);
  }

  .page-hero--photo h1,
  .page-hero--photo .lede {
    color: #fff;
  }

  .page-hero--photo .lede {
    color: rgba(255, 255, 255, 0.85);
  }

  .page-hero__photo {
    position: relative;
    min-height: 340px;
    overflow: hidden;
    border-radius: 160px var(--radius-xl) var(--radius-xl) var(--radius-xl);
  }

  .page-hero__photo :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 900px) {
    .page-hero--photo .page-hero__grid {
      grid-template-columns: 1fr;
    }

    .page-hero--photo .page-hero__copy {
      padding: var(--space-lg) var(--space-md);
    }

    .page-hero__photo {
      min-height: 0;
      aspect-ratio: 16 / 10;
      border-radius: var(--radius-xl) var(--radius-xl) var(--radius-xl) 100px;
    }
  }
</style>
