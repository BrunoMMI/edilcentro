---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Breadcrumbs from '@components/ui/Breadcrumbs.astro';

interface Props {
  title: string;
  subtitle?: string;
  breadcrumbs: { name: string; url: string }[];
  image?: ImageMetadata;
  imageAlt?: string;
  position?: string;
}

const { title, subtitle, breadcrumbs, image, imageAlt = '', position = '50% 50%' } = Astro.props;
---

<section class:list={['page-hero', { 'page-hero--photo': image }]}>
  {
    image && (
      <div class="page-hero__photo">
        <Image
          src={image}
          alt={imageAlt}
          widths={[768, 1200, 1600, 2200]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          style={`object-position: ${position}`}
        />
      </div>
    )
  }
  <div class="container page-hero__inner">
    <Breadcrumbs items={breadcrumbs} light={Boolean(image)} />
    <h1>{title}</h1>
    {subtitle && <p class="lede">{subtitle}</p>}
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    isolation: isolate;
    padding-block: var(--space-xl);
    background: var(--color-paper-alt);
    border-bottom: 1px solid var(--color-border);
  }

  .page-hero__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
  }

  .page-hero h1 {
    font-size: clamp(2.25rem, 5vw, 4rem);
    max-width: 20ch;
    margin-top: var(--space-xs);
  }

  .page-hero .lede {
    max-width: 56ch;
  }

  /* Variante con fotografia a tutta larghezza */
  .page-hero--photo {
    display: flex;
    align-items: flex-end;
    min-height: clamp(340px, 52vh, 560px);
    padding-block: var(--space-xl) clamp(2rem, 5vw, 3.5rem);
    background: var(--color-primary-dark);
    border: 0;
  }

  .page-hero__photo {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .page-hero__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .page-hero--photo::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(0deg, rgba(8, 28, 46, 0.85) 0%, rgba(8, 28, 46, 0.45) 50%, rgba(8, 28, 46, 0.2));
  }

  .page-hero--photo .page-hero__inner {
    padding-top: var(--space-xl);
  }

  .page-hero--photo h1,
  .page-hero--photo .lede {
    color: #fff;
  }

  .page-hero--photo h1 {
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.3);
  }

  .page-hero--photo .lede {
    color: rgba(255, 255, 255, 0.92);
  }

  @media (max-width: 640px) {
    .page-hero--photo {
      min-height: 380px;
    }
  }
</style>
