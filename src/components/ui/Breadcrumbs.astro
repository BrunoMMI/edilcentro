---
interface Crumb {
  name: string;
  url: string;
}

interface Props {
  items: Crumb[];
  light?: boolean;
}

const { items, light = false } = Astro.props;
---

<nav class:list={['breadcrumbs', { 'breadcrumbs--light': light }]} aria-label="Percorso di navigazione">
  <ol>
    {
      items.map((item, index) => (
        <li>
          {index === items.length - 1 ? (
            <span aria-current="page">{item.name}</span>
          ) : (
            <>
              <a href={item.url}>{item.name}</a>
              <span class="breadcrumbs__sep" aria-hidden="true">/</span>
            </>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4em;
    font-size: 0.9375rem;
    color: var(--color-ink-faint);
  }

  .breadcrumbs li {
    display: flex;
    align-items: center;
    gap: 0.4em;
  }

  .breadcrumbs a {
    color: var(--color-ink-faint);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 3px;
    transition: text-decoration-color var(--transition-base), color var(--transition-base);
  }

  .breadcrumbs a:hover {
    color: var(--color-primary);
    text-decoration-color: currentColor;
  }

  .breadcrumbs span[aria-current] {
    color: var(--color-ink);
    font-weight: 600;
  }

  .breadcrumbs--light ol,
  .breadcrumbs--light a {
    color: rgba(255, 255, 255, 0.8);
  }

  .breadcrumbs--light a:hover,
  .breadcrumbs--light span[aria-current] {
    color: #fff;
  }
</style>
