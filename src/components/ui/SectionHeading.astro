---
interface Props {
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
  as?: 'h1' | 'h2' | 'h3';
}

const { title, subtitle, align = 'left', as: Tag = 'h2' }: Props = Astro.props;
---

<div class:list={['section-head', { 'section-head--center': align === 'center' }]} data-reveal>
  <Tag set:html={title} />
  {subtitle && <p class="lede section-head__subtitle">{subtitle}</p>}
</div>

<style>
  .section-head__subtitle {
    margin-top: var(--space-sm);
  }
</style>
