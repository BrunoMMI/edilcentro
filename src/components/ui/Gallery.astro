---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface GalleryItem {
  image: ImageMetadata;
  alt: string;
  /** Slug del filtro (opzionale). */
  group?: string;
}

interface Props {
  items: GalleryItem[];
  filters?: { slug: string; label: string; description?: string }[];
  /** Mostra il pulsante "Tutti" (default). Se false, la galleria parte dal primo filtro. */
  showAll?: boolean;
  filterLabel?: string;
  lightboxLabel?: string;
  /** Layout a mosaico (ogni 7ª foto occupa due colonne) invece della griglia uniforme. */
  mosaic?: boolean;
}

const {
  items,
  filters = [],
  filterLabel = 'Filtra la galleria',
  lightboxLabel = 'Anteprima immagine',
  mosaic = false,
  showAll = true,
} = Astro.props;

const fullSizes = await Promise.all(items.map((item) => getImage({ src: item.image, width: 1600, format: 'webp' })));
---

{
  filters.length > 0 && (
    <div class="gallery-filters" role="group" aria-label={filterLabel}>
      {showAll && (
        <button type="button" data-gallery-filter="all" aria-pressed={showAll ? 'true' : 'false'}>
          Tutti
        </button>
      )}
      {filters.map((filter, index) => (
        <button
          type="button"
          data-gallery-filter={filter.slug}
          data-description={filter.description}
          aria-pressed={!showAll && index === 0 ? 'true' : 'false'}
        >
          {filter.label}
        </button>
      ))}
    </div>
  )
}

{!showAll && <p class="gallery-description" data-gallery-description aria-live="polite">{filters[0]?.description}</p>}

<div class:list={['gallery-grid', { 'gallery-grid--mosaic': mosaic }]} data-gallery>
  {
    items.map((item, index) => (
      <button
        type="button"
        class="gallery-item"
        data-gallery-item
        data-style={item.group}
        data-full={fullSizes[index].src}
        data-alt={item.alt}
        aria-label={`Ingrandisci: ${item.alt}`}
      >
        <Image
          src={item.image}
          alt={item.alt}
          widths={[320, 480, 640]}
          sizes="(max-width: 560px) 50vw, (max-width: 1000px) 33vw, 22vw"
          loading={index < 4 ? 'eager' : 'lazy'}
        />
      </button>
    ))
  }
</div>

<dialog class="lightbox" data-lightbox aria-label={lightboxLabel}>
  <button type="button" class="lightbox__close" data-lightbox-close aria-label="Chiudi anteprima">&times;</button>
  <button type="button" class="lightbox__nav lightbox__nav--prev" data-lightbox-prev aria-label="Immagine precedente">
    &#8592;
  </button>
  <figure>
    <img data-lightbox-img src="" alt="" />
    <figcaption data-lightbox-caption></figcaption>
  </figure>
  <button type="button" class="lightbox__nav lightbox__nav--next" data-lightbox-next aria-label="Immagine successiva">
    &#8594;
  </button>
</dialog>

<script>
  import '../../scripts/gallery.ts';
</script>

<style>
  .gallery-filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md) var(--space-lg);
    margin-bottom: var(--space-md);
    border-bottom: 1px solid var(--color-border);
  }

  .gallery-filters button {
    position: relative;
    min-height: 48px;
    padding: 0.5em 0.1em;
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--color-ink-faint);
    transition: color var(--transition-base);
  }

  .gallery-filters button::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 3px;
    background: var(--color-accent);
    transform: scaleX(0);
    transition: transform var(--transition-base);
  }

  .gallery-filters button:hover {
    color: var(--color-primary-dark);
  }

  .gallery-filters button[aria-pressed='true'] {
    color: var(--color-primary-dark);
  }

  .gallery-filters button[aria-pressed='true']::after {
    transform: scaleX(1);
  }

  .gallery-description {
    margin-bottom: var(--space-md);
    min-height: 1.7em;
    color: var(--color-ink-soft);
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--grout);
  }

  .gallery-item {
    display: block;
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--color-paper-alt);
  }

  .gallery-grid--mosaic .gallery-item:nth-child(7n + 1) {
    grid-column: span 2;
    grid-row: span 2;
    aspect-ratio: auto;
  }

  .gallery-item :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .gallery-item:hover :global(img) {
    transform: scale(1.04);
  }

  @media (max-width: 1000px) {
    .gallery-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 560px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .gallery-grid--mosaic .gallery-item:nth-child(7n + 1) {
      grid-column: 1 / -1;
      grid-row: auto;
      aspect-ratio: 4 / 3;
    }
  }

  .lightbox {
    border: none;
    background: transparent;
    max-width: 94vw;
    max-height: 94vh;
    padding: 0;
    overflow: visible;
  }

  .lightbox::backdrop {
    background: rgba(8, 24, 38, 0.94);
  }

  .lightbox figure {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
  }

  .lightbox img {
    max-width: min(92vw, 1400px);
    max-height: 78vh;
    width: auto;
    border-radius: var(--radius-sm);
    object-fit: contain;
  }

  .lightbox figcaption {
    color: rgba(255, 255, 255, 0.85);
    font-size: 1rem;
    text-align: center;
    max-width: 60ch;
  }

  .lightbox__close,
  .lightbox__nav {
    position: fixed;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.14);
    color: #fff;
    font-size: 1.5rem;
    line-height: 1;
  }

  .lightbox__close {
    top: var(--space-sm);
    right: var(--space-sm);
    font-size: 2rem;
  }

  .lightbox__nav {
    top: 50%;
    transform: translateY(-50%);
  }

  .lightbox__nav:hover,
  .lightbox__close:hover {
    background: rgba(255, 255, 255, 0.3);
  }

  .lightbox__nav--prev {
    left: var(--space-xs);
  }

  .lightbox__nav--next {
    right: var(--space-xs);
  }

  @media (max-width: 700px) {
    .lightbox__nav {
      top: auto;
      bottom: var(--space-sm);
      transform: none;
    }

    .lightbox__nav--prev {
      left: calc(50% - 60px);
    }

    .lightbox__nav--next {
      right: calc(50% - 60px);
    }
  }
</style>
