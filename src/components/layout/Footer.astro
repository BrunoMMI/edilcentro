---
import { Image } from 'astro:assets';
import logo from '@assets/logo/logo-edilcentro-wide.png';
import { mainNav, footerLegalNav } from '@data/nav';
import { categories } from '@data/categories';
import { mainLocation, ferramentaLocation, social, companyName } from '@data/site';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <a href="/" class="footer__logo" aria-label="Edil Centro — torna alla home">
        <Image src={logo} alt="Edil Centro Srl" width={180} height={56} loading="lazy" />
      </a>
      <p>
        Materiali edili, ceramiche e arredo bagno a Pace del Mela dal {' '}1969. Un unico punto di riferimento per
        privati e imprese, con reparto ferramenta dedicato.
      </p>
      <div class="footer__social">
        <a href={social.facebook} target="_blank" rel="noopener noreferrer" aria-label="Edil Centro su Facebook">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M14 9h3V6h-3c-1.7 0-3 1.3-3 3v2H9v3h2v6h3v-6h3l1-3h-4V9c0-.6.4-1 1-1Z"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linejoin="round"
            ></path>
          </svg>
        </a>
        <a href={social.instagram} target="_blank" rel="noopener noreferrer" aria-label="Edil Centro su Instagram">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="4" y="4" width="16" height="16" rx="4" stroke="currentColor" stroke-width="1.5"></rect>
            <circle cx="12" cy="12" r="3.2" stroke="currentColor" stroke-width="1.5"></circle>
            <circle cx="16.2" cy="7.8" r="0.9" fill="currentColor"></circle>
          </svg>
        </a>
      </div>
    </div>

    <nav class="footer__col" aria-label="Sitemap">
      <h4>Il sito</h4>
      <ul>
        {mainNav.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
      </ul>
    </nav>

    <nav class="footer__col" aria-label="Prodotti">
      <h4>Prodotti</h4>
      <ul>
        {categories.slice(0, 6).map((cat) => <li><a href={`/prodotti/#${cat.slug}`}>{cat.title}</a></li>)}
      </ul>
    </nav>

    <div class="footer__col">
      <h4>Showroom</h4>
      <address>
        {mainLocation.street}<br />
        {mainLocation.cap} {mainLocation.city} ({mainLocation.province})<br />
        <a href={mainLocation.phoneHref}>{mainLocation.phone}</a><br />
        <a href={mainLocation.emailHref}>{mainLocation.email}</a>
      </address>
    </div>

    <div class="footer__col">
      <h4>Ferramenta</h4>
      <address>
        {ferramentaLocation.street}<br />
        {ferramentaLocation.cap} {ferramentaLocation.city} ({ferramentaLocation.province})<br />
        <a href={ferramentaLocation.phoneHref}>{ferramentaLocation.phone}</a>
      </address>
    </div>
  </div>

  <div class="footer__bottom">
    <div class="container footer__bottom-inner">
      <p>&copy; {year} {companyName}. Tutti i diritti riservati.</p>
      <ul class="footer__legal">
        {footerLegalNav.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
        <li><button type="button" data-cookie-settings>Gestisci preferenze cookie</button></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-primary-dark);
    color: rgba(243, 241, 236, 0.85);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 2fr repeat(4, 1fr);
    gap: var(--space-lg);
    padding-block: var(--space-2xl) var(--space-xl);
  }

  .footer__logo :global(img) {
    height: 40px;
    width: auto;
    filter: brightness(0) invert(1);
  }

  .footer__brand p {
    margin-top: var(--space-sm);
    color: rgba(243, 241, 236, 0.7);
    font-size: 0.9375rem;
    max-width: 32ch;
  }

  .footer__social {
    display: flex;
    gap: var(--space-sm);
    margin-top: var(--space-md);
  }

  .footer__social a {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: var(--radius-full);
    border: 1px solid rgba(243, 241, 236, 0.25);
    color: #fff;
    transition: background-color var(--transition-base), border-color var(--transition-base);
  }

  .footer__social a:hover {
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  .footer__col h4 {
    color: #fff;
    font-family: var(--font-body);
    font-size: 0.875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: var(--space-sm);
  }

  .footer__col ul {
    display: flex;
    flex-direction: column;
    gap: 0.6em;
  }

  .footer__col a,
  .footer__col button {
    font-size: 0.9375rem;
    color: rgba(243, 241, 236, 0.75);
    transition: color var(--transition-base);
  }

  .footer__col a:hover {
    color: #fff;
  }

  address {
    font-style: normal;
    font-size: 0.9375rem;
    line-height: 1.8;
    color: rgba(243, 241, 236, 0.75);
  }

  address a {
    color: rgba(243, 241, 236, 0.9);
  }

  address a:hover {
    color: #fff;
  }

  .footer__bottom {
    border-top: 1px solid rgba(243, 241, 236, 0.12);
  }

  .footer__bottom-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-sm);
    padding-block: var(--space-md);
    font-size: 0.8125rem;
    color: rgba(243, 241, 236, 0.55);
  }

  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .footer__legal button {
    font-size: 0.8125rem;
    color: rgba(243, 241, 236, 0.55);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .footer__legal a {
    color: rgba(243, 241, 236, 0.55);
  }

  .footer__legal a:hover,
  .footer__legal button:hover {
    color: #fff;
  }

  @media (max-width: 1100px) {
    .footer__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .footer__brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 600px) {
    .footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
