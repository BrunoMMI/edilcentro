---
import logo from '@assets/logo/logo-full.svg';
import { mainNav, footerLegalNav } from '@data/nav';
import { categories } from '@data/categories';
import { mainLocation, ferramentaLocation, social, companyName, foundedYear } from '@data/site';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__roof" aria-hidden="true"></div>
  <div class="container footer__grid">
    <div class="footer__brand">
      <a href="/" class="footer__logo" aria-label="Edil Centro — torna alla home">
        <img src={logo.src} width={logo.width} height={logo.height} alt="Edil Centro s.r.l. — dal 1969 Ceramiche Valenti" loading="lazy" decoding="async" />
      </a>
      <p>
        Materiali edili, ceramiche, sanitari e arredo bagno a Pace del Mela dal {foundedYear}. Un unico punto di
        riferimento per privati e imprese, con reparto ferramenta dedicato.
      </p>
      <div class="footer__social">
        <a href={social.facebook} target="_blank" rel="noopener noreferrer" aria-label="Edil Centro su Facebook">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M14 9h3V6h-3c-1.7 0-3 1.3-3 3v2H9v3h2v6h3v-6h3l1-3h-4V9c0-.6.4-1 1-1Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path>
          </svg>
        </a>
        <a href={social.instagram} target="_blank" rel="noopener noreferrer" aria-label="Edil Centro su Instagram">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="4" y="4" width="16" height="16" rx="4" stroke="currentColor" stroke-width="1.5"></rect>
            <circle cx="12" cy="12" r="3.2" stroke="currentColor" stroke-width="1.5"></circle>
            <circle cx="16.2" cy="7.8" r="0.9" fill="currentColor"></circle>
          </svg>
        </a>
      </div>
    </div>

    <nav class="footer__col" aria-label="Pagine del sito">
      <h4>Il sito</h4>
      <ul>
        {mainNav.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
      </ul>
    </nav>

    <nav class="footer__col" aria-label="Categorie di prodotto">
      <h4>Prodotti</h4>
      <ul>
        {categories.map((cat) => <li><a href={`/prodotti/#${cat.slug}`}>{cat.title}</a></li>)}
      </ul>
    </nav>

    <div class="footer__col">
      <h4>Showroom</h4>
      <address>
        {mainLocation.street}<br />
        {mainLocation.cap} {mainLocation.city} ({mainLocation.province})<br />
        <a href={mainLocation.phoneHref}>{mainLocation.phone}</a><br />
        <a href={mainLocation.emailHref}>{mainLocation.email}</a>
      </address>
    </div>

    <div class="footer__col">
      <h4>Ferramenta</h4>
      <address>
        {ferramentaLocation.street}<br />
        {ferramentaLocation.cap} {ferramentaLocation.city} ({ferramentaLocation.province})<br />
        <a href={ferramentaLocation.phoneHref}>{ferramentaLocation.phone}</a>
      </address>
      <ul class="footer__hours">
        {ferramentaLocation.hours?.map((slot) => <li><span>{slot.days}</span> <span>{slot.time}</span></li>)}
      </ul>
    </div>
  </div>

  <div class="footer__bottom">
    <div class="container footer__bottom-inner">
      <p>&copy; {year} {companyName}. Tutti i diritti riservati.</p>
      <ul class="footer__legal">
        {footerLegalNav.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
        <li><button type="button" data-cookie-settings>Preferenze cookie</button></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-primary-dark);
    color: rgba(238, 243, 246, 0.88);
    position: relative;
    overflow: hidden;
  }

  /* Doppia linea blu/verde: richiamo al tetto del logo */
  .footer__roof {
    height: 8px;
    background: linear-gradient(to bottom, var(--color-primary) 0 50%, var(--color-accent) 50% 100%);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1.6fr 0.8fr 1fr 1.1fr 1.2fr;
    gap: var(--space-lg);
    padding-block: var(--space-xl);
  }

  .footer__logo {
    display: block;
    background: #fff;
    padding: 14px 18px;
    width: min(100%, 320px);
    border-radius: var(--radius-sm);
  }

  .footer__logo img {
    width: 100%;
    height: auto;
  }

  .footer__brand p {
    margin-top: var(--space-md);
    color: rgba(238, 243, 246, 0.78);
    font-size: 1rem;
    max-width: 34ch;
  }

  .footer__social {
    display: flex;
    gap: var(--space-xs);
    margin-top: var(--space-md);
  }

  .footer__social a {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid rgba(238, 243, 246, 0.35);
    color: #fff;
    transition: background-color var(--transition-base), border-color var(--transition-base);
  }

  .footer__social a:hover {
    background: #fff;
    color: var(--color-primary-dark);
  }

  .footer__col h4 {
    color: #fff;
    font-size: 1.0625rem;
    margin-bottom: var(--space-sm);
  }

  .footer__col ul:not(.footer__hours) {
    display: flex;
    flex-direction: column;
  }

  .footer__col ul a {
    display: inline-block;
    padding-block: 0.3em;
    font-size: 1rem;
    color: rgba(238, 243, 246, 0.8);
  }

  a:hover {
    color: #fff;
  }

  address {
    font-style: normal;
    font-size: 1rem;
    line-height: 1.8;
    color: rgba(238, 243, 246, 0.8);
  }

  address a {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(255, 255, 255, 0.4);
  }

  .footer__hours {
    margin-top: var(--space-sm);
    font-size: 0.9375rem;
    color: rgba(238, 243, 246, 0.78);
  }

  .footer__hours li {
    display: flex;
    flex-direction: column;
    padding-block: 0.25em;
  }

  .footer__hours li span:first-child {
    color: #fff;
    font-weight: 600;
  }

  .footer__bottom {
    border-top: 1px solid rgba(238, 243, 246, 0.16);
  }

  .footer__bottom-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-xs) var(--space-md);
    padding-block: var(--space-sm);
    font-size: 0.9375rem;
  }

  .footer__bottom-inner p {
    color: rgba(238, 243, 246, 0.75);
  }

  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-md);
  }

  .footer__legal a,
  .footer__legal button {
    display: inline-block;
    padding-block: 0.6em;
    font-size: 0.9375rem;
    color: rgba(238, 243, 246, 0.85);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(238, 243, 246, 0.35);
  }

  .footer__legal a:hover,
  .footer__legal button:hover {
    color: #fff;
  }

  @media (max-width: 1100px) {
    .footer__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .footer__brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 560px) {
    .footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
