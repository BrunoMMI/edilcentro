---
import logo from '@assets/logo/logo-wordmark.svg';
import { mainNav } from '@data/nav';
import { mainLocation } from '@data/site';

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="header" data-site-header>
  <div class="header__bar">
    <a href="/" class="header__logo" aria-label="Edil Centro Srl — torna alla home">
      <img src={logo.src} width={logo.width} height={logo.height} alt="Edil Centro s.r.l." decoding="async" />
    </a>

    <nav class="header__nav" aria-label="Navigazione principale">
      <ul>
        {
          mainNav.map((link) => (
            <li>
              <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header__actions">
      <a href={mainLocation.phoneHref} class="header__phone" aria-label={`Chiama lo showroom ${mainLocation.phone}`}>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.4c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1L6.6 10.8Z"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        <span>{mainLocation.phone}</span>
      </a>
      <a href="/contatti/" class="btn btn-primary btn-sm header__cta">Contattaci</a>

      <button
        type="button"
        class="header__toggle"
        data-nav-toggle
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Apri il menu di navigazione"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <div class="mobile-nav" id="mobile-nav" data-mobile-nav data-open="false">
    <nav aria-label="Navigazione mobile">
      <ul>
        {
          mainNav.map((link) => (
            <li>
              <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="mobile-nav__footer">
      <a href={mainLocation.phoneHref} class="btn btn-secondary">Chiama {mainLocation.phone}</a>
      <a href="/contatti/" class="btn btn-primary">Richiedi un preventivo</a>
    </div>
  </div>
</header>

<script>
  import '../../scripts/header.ts';
</script>

<style>
  /* Header "pillola" fluttuante */
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    padding: 12px var(--container-pad) 0;
    pointer-events: none;
  }

  .header__bar {
    pointer-events: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    height: 84px;
    max-width: calc(var(--container-max) - 2 * var(--container-pad) + 2rem);
    margin-inline: auto;
    padding-inline: 22px 14px;
    background: rgba(255, 255, 255, 0.9);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    backdrop-filter: blur(14px) saturate(1.4);
    border: 1px solid rgba(13, 44, 70, 0.08);
    border-radius: var(--radius-full);
    box-shadow: 0 14px 34px -22px rgba(13, 44, 70, 0.5);
    transition: box-shadow var(--transition-base), background-color var(--transition-base);
  }

  .header.is-scrolled .header__bar {
    background: rgba(255, 255, 255, 0.96);
    box-shadow: 0 22px 44px -22px rgba(13, 44, 70, 0.6);
  }

  .header__logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  /* Logo grande e leggibile: ~62px di altezza su desktop */
  .header__logo img {
    height: 60px;
    width: auto;
  }

  .header__nav ul {
    display: flex;
    gap: 4px;
  }

  .header__nav a {
    display: block;
    font-weight: 600;
    font-size: 1rem;
    color: var(--color-ink-soft);
    padding: 0.6em 1em;
    border-radius: var(--radius-full);
    transition: color var(--transition-base), background-color var(--transition-base);
  }

  .header__nav a:hover {
    color: var(--color-ink);
    background: var(--color-paper-alt);
  }

  .header__nav a[aria-current='page'] {
    color: var(--color-primary-dark);
    background: var(--color-accent-light);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .header__phone {
    display: none;
    align-items: center;
    gap: 0.5em;
    font-weight: 700;
    font-size: 1rem;
    color: var(--color-primary-dark);
    white-space: nowrap;
  }

  .header__toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    width: 52px;
    height: 52px;
    background: var(--color-primary-dark);
    border-radius: var(--radius-full);
  }

  .header__toggle span {
    display: block;
    width: 22px;
    height: 2px;
    background: #fff;
    border-radius: 2px;
    transition: transform var(--transition-base), opacity var(--transition-base);
    margin-inline: auto;
  }

  .header__toggle[aria-expanded='true'] span:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }

  .header__toggle[aria-expanded='true'] span:nth-child(2) {
    opacity: 0;
  }

  .header__toggle[aria-expanded='true'] span:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  .mobile-nav {
    display: none;
  }

  @media (min-width: 1280px) {
    .header__phone {
      display: flex;
    }
  }

  @media (max-width: 1080px) {
    .header__nav,
    .header__cta {
      display: none;
    }

    .header__bar {
      height: 72px;
    }

    .header__toggle {
      display: flex;
      width: 48px;
      height: 48px;
    }

    .mobile-nav {
      pointer-events: auto;
      display: block;
      position: fixed;
      inset: var(--header-height) 0 0 0;
      background: var(--color-paper);
      border-radius: var(--radius-xl) var(--radius-xl) 0 0;
      padding: var(--space-lg) var(--container-pad);
      transform: translateY(24px);
      opacity: 0;
      visibility: hidden;
      transition: transform var(--transition-slow), opacity var(--transition-base), visibility 0s linear 600ms;
      overflow-y: auto;
    }

    .mobile-nav[data-open='true'] {
      transform: none;
      opacity: 1;
      visibility: visible;
      transition: transform var(--transition-slow), opacity var(--transition-base);
    }

    .mobile-nav ul {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .mobile-nav a:not(.btn) {
      display: block;
      padding: 0.55em 0.8em;
      border-radius: var(--radius-full);
      font-family: var(--font-display);
      font-size: 1.75rem;
      font-weight: 700;
      letter-spacing: -0.02em;
    }

    .mobile-nav a[aria-current='page'] {
      color: var(--color-primary-dark);
      background: var(--color-accent-light);
    }

    .mobile-nav__footer {
      display: flex;
      flex-direction: column;
      gap: var(--space-sm);
      margin-top: var(--space-lg);
    }
  }

  @media (max-width: 480px) {
    .header__logo img {
      height: 44px;
    }

    .header__bar {
      padding-inline: 16px 10px;
    }
  }
</style>
