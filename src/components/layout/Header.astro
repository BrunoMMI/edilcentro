---
import logo from '@assets/logo/logo-wordmark.svg';
import { mainNav } from '@data/nav';
import { mainLocation } from '@data/site';

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="header" data-site-header>
  <div class="header__bar">
    <a href="/" class="header__logo" aria-label="Edil Centro Srl — torna alla home">
      <img src={logo.src} width={logo.width} height={logo.height} alt="Edil Centro s.r.l." decoding="async" />
    </a>

    <nav class="header__nav" aria-label="Navigazione principale">
      <ul>
        {
          mainNav.map((link) => (
            <li>
              <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header__actions">
      <a href={mainLocation.phoneHref} class="header__phone" aria-label={`Chiama lo showroom ${mainLocation.phone}`}>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.4c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1L6.6 10.8Z"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        <span>{mainLocation.phone}</span>
      </a>
      <a href="/contatti/" class="btn btn-primary btn-sm header__cta">Contattaci</a>

      <button
        type="button"
        class="header__toggle"
        data-nav-toggle
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Apri il menu di navigazione"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <div class="mobile-nav" id="mobile-nav" data-mobile-nav data-open="false">
    <nav aria-label="Navigazione mobile">
      <ul>
        {
          mainNav.map((link) => (
            <li>
              <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="mobile-nav__footer">
      <a href={mainLocation.phoneHref} class="btn btn-secondary">Chiama {mainLocation.phone}</a>
      <a href="/contatti/" class="btn btn-primary">Richiedi un preventivo</a>
    </div>
  </div>
</header>

<script>
  import '../../scripts/header.ts';
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: #fff;
    border-bottom: 1px solid var(--color-border);
    transition: box-shadow var(--transition-base);
  }

  .header.is-scrolled {
    box-shadow: 0 10px 30px -22px rgba(13, 44, 70, 0.6);
  }

  .header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    height: var(--header-height);
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--container-pad);
  }

  .header__logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .header__logo img {
    height: 58px;
    width: auto;
  }

  .header__nav {
    margin-left: auto;
  }

  .header__nav ul {
    display: flex;
    gap: clamp(0.25rem, 1.4vw, 1.5rem);
  }

  .header__nav a {
    position: relative;
    display: block;
    font-family: var(--font-display);
    font-size: 1.125rem;
    color: var(--color-primary-dark);
    padding: 0.5em 0.35em;
    transition: color var(--transition-base);
  }

  .header__nav a::after {
    content: '';
    position: absolute;
    left: 0.35em;
    right: 0.35em;
    bottom: 0.1em;
    height: 2px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--transition-base);
  }

  .header__nav a:hover::after,
  .header__nav a[aria-current='page']::after {
    transform: scaleX(1);
  }

  .header__nav a:hover {
    color: var(--color-primary);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .header__phone {
    display: none;
    align-items: center;
    gap: 0.5em;
    font-weight: 600;
    font-size: 1rem;
    color: var(--color-primary-dark);
    white-space: nowrap;
  }

  .header__toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    width: 48px;
    height: 48px;
    background: var(--color-primary);
    border-radius: var(--radius-sm);
  }

  .header__toggle span {
    display: block;
    width: 22px;
    height: 2px;
    background: #fff;
    transition: transform var(--transition-base), opacity var(--transition-base);
    margin-inline: auto;
  }

  .header__toggle[aria-expanded='true'] span:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }

  .header__toggle[aria-expanded='true'] span:nth-child(2) {
    opacity: 0;
  }

  .header__toggle[aria-expanded='true'] span:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  .mobile-nav {
    display: none;
  }

  @media (min-width: 1280px) {
    .header__phone {
      display: flex;
    }
  }

  @media (max-width: 1080px) {
    .header__nav,
    .header__cta {
      display: none;
    }

    .header__logo img {
      height: 48px;
    }

    .header__toggle {
      display: flex;
    }

    .mobile-nav {
      display: block;
      position: fixed;
      inset: var(--header-height) 0 0 0;
      background: #fff;
      padding: var(--space-lg) var(--container-pad);
      transform: translateY(12px);
      opacity: 0;
      visibility: hidden;
      transition: transform var(--transition-slow), opacity var(--transition-base), visibility 0s linear 600ms;
      overflow-y: auto;
    }

    .mobile-nav[data-open='true'] {
      transform: none;
      opacity: 1;
      visibility: visible;
      transition: transform var(--transition-slow), opacity var(--transition-base);
    }

    .mobile-nav ul {
      display: flex;
      flex-direction: column;
    }

    .mobile-nav li + li {
      border-top: 1px solid var(--color-border);
    }

    .mobile-nav a:not(.btn) {
      display: block;
      padding: 0.7em 0;
      font-family: var(--font-display);
      font-size: 1.75rem;
      color: var(--color-primary-dark);
    }

    .mobile-nav a[aria-current='page'] {
      color: var(--color-accent-dark);
    }

    .mobile-nav__footer {
      display: flex;
      flex-direction: column;
      gap: var(--space-sm);
      margin-top: var(--space-lg);
    }
  }

  @media (max-width: 480px) {
    .header__logo img {
      height: 42px;
    }
  }
</style>
