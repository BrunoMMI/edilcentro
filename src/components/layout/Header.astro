---
import { Image } from 'astro:assets';
import logo from '@assets/logo/logo-edilcentro-wide.png';
import { mainNav } from '@data/nav';
import { mainLocation } from '@data/site';

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="header" data-site-header>
  <div class="header__bar container">
    <a href="/" class="header__logo" aria-label="Edil Centro — torna alla home">
      <Image src={logo} alt="Edil Centro Srl" width={168} height={52} loading="eager" />
    </a>

    <nav class="header__nav" aria-label="Navigazione principale">
      <ul>
        {
          mainNav.map((link) => (
            <li>
              <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header__actions">
      <a href={mainLocation.phoneHref} class="header__phone">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.4c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1L6.6 10.8Z"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
        </svg>
        <span>{mainLocation.phone}</span>
      </a>
      <a href="/contatti/" class="btn btn-primary btn-sm">Contattaci</a>

      <button
        type="button"
        class="header__toggle"
        data-nav-toggle
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Apri il menu di navigazione"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <div class="mobile-nav" id="mobile-nav" data-mobile-nav data-open="false">
    <nav aria-label="Navigazione mobile">
      <ul>
        {
          mainNav.map((link) => (
            <li>
              <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="mobile-nav__footer">
      <a href={mainLocation.phoneHref} class="btn btn-secondary">Chiama {mainLocation.phone}</a>
      <a href="/contatti/" class="btn btn-primary">Richiedi un preventivo</a>
    </div>
  </div>
</header>

<script>
  import '../../scripts/header.ts';
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(247, 245, 241, 0.85);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid transparent;
    transition: border-color var(--transition-base), background-color var(--transition-base), box-shadow var(--transition-base);
  }

  .header.is-scrolled {
    border-color: var(--color-border);
    box-shadow: var(--shadow-sm);
  }

  .header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    height: var(--header-height);
  }

  .header__logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .header__logo :global(img) {
    height: 40px;
    width: auto;
  }

  .header__nav ul {
    display: flex;
    gap: var(--space-lg);
  }

  .header__nav a {
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--color-ink-soft);
    padding-block: 0.4em;
    position: relative;
    transition: color var(--transition-base);
  }

  .header__nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 100%;
    bottom: -2px;
    height: 2px;
    background: var(--color-accent);
    transition: right var(--transition-base);
  }

  .header__nav a:hover,
  .header__nav a[aria-current='page'] {
    color: var(--color-ink);
  }

  .header__nav a:hover::after,
  .header__nav a[aria-current='page']::after {
    right: 0;
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .header__phone {
    display: flex;
    align-items: center;
    gap: 0.5em;
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--color-primary-dark);
  }

  .header__toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
  }

  .header__toggle span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--color-ink);
    transition: transform var(--transition-base), opacity var(--transition-base);
    margin-inline: auto;
  }

  .header__toggle[aria-expanded='true'] span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .header__toggle[aria-expanded='true'] span:nth-child(2) {
    opacity: 0;
  }

  .header__toggle[aria-expanded='true'] span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .mobile-nav {
    display: none;
  }

  @media (max-width: 900px) {
    .header__nav {
      display: none;
    }

    .header__phone {
      display: none;
    }

    .header__toggle {
      display: flex;
    }

    .mobile-nav {
      display: block;
      position: fixed;
      inset: var(--header-height) 0 0 0;
      background: var(--color-paper);
      padding: var(--space-lg) var(--container-pad);
      transform: translateX(100%);
      transition: transform var(--transition-slow);
      overflow-y: auto;
    }

    .mobile-nav[data-open='true'] {
      transform: translateX(0);
    }

    .mobile-nav ul {
      display: flex;
      flex-direction: column;
      gap: var(--space-sm);
    }

    .mobile-nav a {
      font-family: var(--font-display);
      font-size: 1.75rem;
      font-weight: 600;
    }

    .mobile-nav__footer {
      display: flex;
      flex-direction: column;
      gap: var(--space-sm);
      margin-top: var(--space-xl);
    }
  }
</style>
