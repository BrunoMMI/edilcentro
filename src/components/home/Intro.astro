---
import { Image } from 'astro:assets';
import { showroomPhoto } from '@data/showroom';
import { foundedYear, yearsOfActivity, mainLocation } from '@data/site';

const storefront = showroomPhoto('facciata-ceramiche');
const inset = showroomPhoto('campionari-piastrelle');
---

<section class="intro section">
  <div class="container intro__grid">
    <div class="intro__copy">
      <h2 data-reveal>Dal {foundedYear} un punto di riferimento per edilizia e arredo bagno nel Messinese</h2>
      <p class="lede" data-reveal data-reveal-index="1">
        Edil Centro fornisce materiali edili, ceramiche e soluzioni per la ristrutturazione a privati e imprese.
        In oltre {yearsOfActivity} anni di attività, a partire dalla storica esperienza di Ceramiche Valenti,
        abbiamo costruito un catalogo ampio e un rapporto di fiducia con chi ci sceglie.
      </p>
      <p data-reveal data-reveal-index="2">
        Lo showroom di Pace del Mela riunisce pavimenti, rivestimenti, sanitari, arredo bagno, rubinetteria e
        termoarredo. Il reparto Ferramenta, in una sede distinta, completa l'offerta con utensili e materiali
        per l'edilizia.
      </p>
      <div class="intro__actions" data-reveal data-reveal-index="3">
        <a href="/showroom/" class="btn btn-primary">Vedi lo showroom</a>
        <a href="/contatti/" class="btn btn-secondary">Come raggiungerci</a>
      </div>
    </div>

    <div class="intro__photos" data-reveal="fade">
      <figure class="intro__main">
        <Image src={storefront.image} alt={storefront.alt} widths={[480, 720, 960]} sizes="(max-width: 900px) 100vw, 48vw" />
        <figcaption>{mainLocation.street}, {mainLocation.city}</figcaption>
      </figure>
      <figure class="intro__inset">
        <Image src={inset.image} alt={inset.alt} widths={[320, 480]} sizes="(max-width: 900px) 40vw, 20vw" />
      </figure>
    </div>
  </div>
</section>

<style>
  .intro__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
  }

  .intro__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-md);
  }

  .intro__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-xs);
  }

  .intro__photos {
    position: relative;
    padding-bottom: 3.5rem;
    padding-right: 3.5rem;
  }

  .intro__main {
    position: relative;
  }

  .intro__main :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .intro__main figcaption {
    margin-top: var(--space-2xs);
    font-size: 0.9375rem;
    color: var(--color-ink-faint);
  }

  .intro__inset {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 42%;
    border: 8px solid #fff;
    box-shadow: var(--shadow-md);
  }

  .intro__inset :global(img) {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }

  @media (max-width: 900px) {
    .intro__grid {
      grid-template-columns: 1fr;
    }

    .intro__photos {
      padding-right: 2rem;
    }
  }

  @media (max-width: 560px) {
    .intro__photos {
      padding-right: 0;
      padding-bottom: 0;
    }

    .intro__inset {
      display: none;
    }
  }
</style>
