---
import SectionHeading from '@components/ui/SectionHeading.astro';
import { mainLocation, ferramentaLocation } from '@data/site';

const locations = [
  { ...mainLocation, tag: 'Showroom', description: 'Pavimenti, rivestimenti, sanitari e arredo bagno.' },
  { ...ferramentaLocation, tag: 'Ferramenta', description: 'Utensili e materiali per l’edilizia.' },
];
---

<section class="contact-strip section section--alt">
  <div class="container">
    <SectionHeading eyebrow="Vieni a trovarci" title="Due sedi a Pace del Mela" align="center" />

    <div class="contact-strip__grid">
      {
        locations.map((loc, index) => (
          <div class="contact-card" data-reveal data-reveal-index={index}>
            <span class="contact-card__tag">{loc.tag}</span>
            <h3>{loc.name}</h3>
            <p>{loc.description}</p>
            <address>
              {loc.street}<br />
              {loc.cap} {loc.city} ({loc.province})
            </address>
            <div class="contact-card__actions">
              <a href={loc.phoneHref} class="btn btn-secondary btn-sm">Chiama {loc.phone}</a>
              <a href={loc.mapsHref} target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm">
                Indicazioni
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .contact-strip__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
  }

  .contact-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
  }

  .contact-card__tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent-dark);
    background: var(--color-accent-light);
    padding: 0.3em 0.7em;
    border-radius: var(--radius-full);
    margin-bottom: var(--space-sm);
  }

  .contact-card h3 {
    font-size: 1.25rem;
    margin-bottom: 0.3em;
  }

  .contact-card > p {
    font-size: 0.9375rem;
    margin-bottom: var(--space-sm);
  }

  .contact-card address {
    font-style: normal;
    font-size: 0.9375rem;
    color: var(--color-ink-soft);
    line-height: 1.6;
    margin-bottom: var(--space-md);
  }

  .contact-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6em;
  }

  @media (max-width: 720px) {
    .contact-strip__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
