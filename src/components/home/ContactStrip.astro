---
import SectionHeading from '@components/ui/SectionHeading.astro';
import { mainLocation, ferramentaLocation } from '@data/site';

const locations = [
  { ...mainLocation, tag: 'Showroom', description: 'Pavimenti, rivestimenti, sanitari e arredo bagno.' },
  { ...ferramentaLocation, tag: 'Ferramenta', description: 'Utensili e materiali per l’edilizia.' },
];
---

<section class="contact-strip section section--alt">
  <div class="container">
    <SectionHeading title="Due sedi a Pace del Mela" subtitle="Lo showroom e il reparto Ferramenta, entrambi a Pace del Mela." />

    <div class="contact-strip__grid">
      {
        locations.map((loc, index) => (
          <div class="contact-card" data-reveal data-reveal-index={index}>
            <h3>{loc.name}</h3>
            <p>{loc.description}</p>
            <address>
              {loc.street}<br />
              {loc.cap} {loc.city} ({loc.province})
            </address>
            {loc.hours && (
              <ul class="contact-card__hours">
                {loc.hours.map((slot) => (
                  <li>
                    <span>{slot.days}</span>
                    <span>{slot.time}</span>
                  </li>
                ))}
              </ul>
            )}
            <div class="contact-card__actions">
              <a href={loc.phoneHref} class="btn btn-primary btn-sm">Chiama {loc.phone}</a>
              <a href={loc.mapsHref} target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm">
                Indicazioni
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .contact-strip__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
  }

  .contact-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
    padding: var(--space-lg);
    background: #fff;
    border-top: 3px solid var(--color-primary);
  }

  .contact-card:nth-child(2) {
    border-top-color: var(--color-accent);
  }

  .contact-card address {
    font-style: normal;
    font-weight: 600;
    color: var(--color-ink);
  }

  .contact-card__hours {
    width: 100%;
    max-width: 26rem;
    font-size: 0.9375rem;
  }

  .contact-card__hours li {
    display: flex;
    justify-content: space-between;
    gap: var(--space-sm);
    padding-block: 0.35em;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-ink-soft);
  }

  .contact-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: auto;
    padding-top: var(--space-sm);
  }

  @media (max-width: 800px) {
    .contact-strip__grid {
      grid-template-columns: 1fr;
    }

    .contact-card {
      padding: var(--space-md);
    }
  }
</style>
