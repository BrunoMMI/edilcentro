---
import { Image } from 'astro:assets';
import SectionHeading from '@components/ui/SectionHeading.astro';
import { showroomPhoto } from '@data/showroom';

const photos = [
  showroomPhoto('galleria-coperta-cotto-e-legno'),
  showroomPhoto('corridoio-espositori-onice'),
  showroomPhoto('espositore-gres-effetto-legno'),
  showroomPhoto('espositore-casalgrande-padana'),
  showroomPhoto('sala-pavimenti-decorati'),
  showroomPhoto('galleria-coperta-cerlat'),
  showroomPhoto('ingresso-galleria-coperta'),
];
---

<section class="strip section section--alt">
  <div class="container">
    <div class="strip__head">
      <SectionHeading
        title="Lo showroom: tutto da vedere e toccare"
        subtitle="Lastre di grande formato, campionari, decori e sanitari esposti in ambienti reali. Passa a vedere i materiali dal vivo."
      />
      <a href="/showroom/" class="btn btn-secondary" data-reveal>Tutte le foto dello showroom</a>
    </div>

    <div class="strip__wall">
      {
        photos.map((photo, index) => (
          <a href="/showroom/" class={`strip__tile strip__tile--${index + 1}`} aria-label={photo.alt}>
            <Image
              src={photo.image}
              alt={photo.alt}
              widths={[320, 480, 720, 960]}
              sizes={index === 0 ? '(max-width: 700px) 100vw, 50vw' : '(max-width: 700px) 50vw, 25vw'}
            />
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .strip__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .strip__head :global(.section-head) {
    margin-bottom: 0;
  }

  .strip__wall {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: clamp(150px, 17vw, 240px);
    gap: var(--grout);
  }

  .strip__tile {
    position: relative;
    overflow: hidden;
    background: var(--color-border);
  }

  .strip__tile--1 {
    grid-column: span 2;
    grid-row: span 2;
  }

  .strip__tile--6,
  .strip__tile--7 {
    grid-column: span 2;
  }

  .strip__tile :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .strip__tile:hover :global(img) {
    transform: scale(1.05);
  }

  @media (max-width: 700px) {
    .strip__wall {
      grid-template-columns: 1fr 1fr;
      grid-auto-rows: 38vw;
      gap: 8px;
    }

    .strip__tile--1 {
      grid-column: 1 / -1;
      grid-row: span 2;
    }

    .strip__tile--6,
    .strip__tile--7 {
      grid-column: span 1;
    }
  }
</style>
