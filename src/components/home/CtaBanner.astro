---
import { getImage } from 'astro:assets';
import { mainLocation } from '@data/site';
import { showroomPhoto } from '@data/showroom';

const bg = await getImage({ src: showroomPhoto('showroom-ceramiche-e-cucine').image, width: 2000, format: 'webp' });
---

<section class="cta photo-band photo-band--fixed" style={`background-image: url(${bg.src})`}>
  <div class="container cta__inner">
    <h2>Hai in mente un progetto? Parliamone in showroom.</h2>
    <p class="lede">
      Vieni a trovarci a Pace del Mela per una consulenza, oppure contattaci per informazioni su prodotti,
      disponibilità e render 3D.
    </p>
    <div class="cta__actions">
      <a href="/contatti/" class="btn btn-light">Richiedi un preventivo</a>
      <a href={mainLocation.phoneHref} class="btn btn-outline-light">Chiama {mainLocation.phone}</a>
    </div>
  </div>
</section>

<style>
  .cta {
    padding-block: clamp(4rem, 10vw, 8rem);
    text-align: center;
  }

  .cta__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
  }

  .cta h2 {
    max-width: 22ch;
  }

  .cta p {
    max-width: 52ch;
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-xs);
    margin-top: var(--space-xs);
  }

  @media (max-width: 480px) {
    .cta__actions {
      width: 100%;
      flex-direction: column;
    }
  }
</style>
