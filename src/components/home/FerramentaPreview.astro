---
import { Image } from 'astro:assets';
import img from '@assets/ferramenta/ferramenta-edil-centro-02.webp';
import { ferramentaLocation } from '@data/site';
---

<section class="ferramenta-preview section section--alt">
  <div class="container ferramenta-preview__grid">
    <figure class="ferramenta-preview__image leaf leaf--alt" data-reveal="fade">
      <Image
        src={img}
        alt="Reparto Ferramenta Edil Centro: esposizione di utensili e materiali per l'edilizia"
        widths={[480, 720, 960]}
        sizes="(max-width: 900px) 100vw, 46vw"
      />
    </figure>

    <div class="ferramenta-preview__copy">
      <h2 data-reveal>Ferramenta: tutto per costruire, riparare, rinnovare</h2>
      <p class="lede" data-reveal data-reveal-index="1">
        In una sede distinta a Pace del Mela, il reparto Ferramenta di Edil Centro mette a disposizione
        utensili, sistemi di fissaggio, sigillanti, vernici e materiali per l'edilizia, con uno staff pronto a
        consigliare la soluzione giusta.
      </p>
      <p class="ferramenta-preview__address" data-reveal data-reveal-index="2">
        {ferramentaLocation.street}, {ferramentaLocation.city} ({ferramentaLocation.province})
      </p>
      <a href="/ferramenta/" class="btn btn-primary" data-reveal data-reveal-index="3">Scopri la Ferramenta</a>
    </div>
  </div>
</section>

<style>
  .ferramenta-preview__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    align-items: center;
  }

  .ferramenta-preview__image {
    aspect-ratio: 4 / 3.4;
    box-shadow: var(--shadow-lg);
  }

  .ferramenta-preview__image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ferramenta-preview__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-md);
  }

  .ferramenta-preview__address {
    font-weight: 600;
    color: var(--color-ink);
    padding: 0.5em 1.1em;
    background: var(--color-accent-light);
    border-radius: var(--radius-full);
  }

  @media (max-width: 900px) {
    .ferramenta-preview__grid {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
  }
</style>
