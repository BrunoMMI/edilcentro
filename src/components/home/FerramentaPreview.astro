---
import { Image } from 'astro:assets';
import img from '@assets/ferramenta/ferramenta-edil-centro-02.webp';
import img2 from '@assets/ferramenta/ferramenta-edil-centro-05.webp';
import { ferramentaLocation } from '@data/site';
---

<section class="ferramenta-preview section section--alt">
  <div class="container ferramenta-preview__grid">
    <div class="ferramenta-preview__images" data-reveal="fade">
      <figure class="ferramenta-preview__main">
        <Image
          src={img}
          alt="Reparto Ferramenta Edil Centro: esposizione di utensili e materiali per l'edilizia"
          widths={[480, 720, 960]}
          sizes="(max-width: 900px) 100vw, 46vw"
        />
      </figure>
      <figure class="ferramenta-preview__inset">
        <Image
          src={img2}
          alt="Pannello con utensili manuali nel reparto Ferramenta Edil Centro"
          widths={[320, 480]}
          sizes="(max-width: 900px) 40vw, 20vw"
        />
      </figure>
    </div>

    <div class="ferramenta-preview__copy">
      <h2 data-reveal>Ferramenta: tutto per costruire, riparare, rinnovare</h2>
      <p class="lede" data-reveal data-reveal-index="1">
        In una sede distinta a Pace del Mela, il reparto Ferramenta di Edil Centro mette a disposizione
        utensili, sistemi di fissaggio, sigillanti, vernici e materiali per l'edilizia, con uno staff pronto a
        consigliare la soluzione giusta.
      </p>
      <p class="ferramenta-preview__address" data-reveal data-reveal-index="2">
        {ferramentaLocation.street}, {ferramentaLocation.city} ({ferramentaLocation.province})
      </p>
      <a href="/ferramenta/" class="btn btn-primary" data-reveal data-reveal-index="3">Scopri la Ferramenta</a>
    </div>
  </div>
</section>

<style>
  .ferramenta-preview__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
  }

  .ferramenta-preview__images {
    position: relative;
    padding-bottom: 3rem;
    padding-right: 3rem;
  }

  .ferramenta-preview__main :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .ferramenta-preview__inset {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 40%;
    border: 8px solid var(--color-paper-alt);
    box-shadow: var(--shadow-md);
  }

  .ferramenta-preview__inset :global(img) {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .ferramenta-preview__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-md);
  }

  .ferramenta-preview__address {
    font-weight: 600;
    color: var(--color-primary-dark);
  }

  @media (max-width: 900px) {
    .ferramenta-preview__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .ferramenta-preview__images {
      padding: 0;
    }

    .ferramenta-preview__inset {
      display: none;
    }
  }
</style>
