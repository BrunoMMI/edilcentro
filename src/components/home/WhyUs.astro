---
import { Image } from 'astro:assets';
import SectionHeading from '@components/ui/SectionHeading.astro';
import { showroomPhoto } from '@data/showroom';
import { whyUsPoints } from '@data/content';

const photo = showroomPhoto('sala-consulenza-clienti');
---

<section class="whyus section section--alt">
  <div class="container whyus__grid">
    <div class="whyus__image leaf" data-reveal="fade">
      <Image src={photo.image} alt={photo.alt} widths={[480, 720, 960]} sizes="(max-width: 900px) 100vw, 44vw" />
    </div>

    <div class="whyus__copy">
      <SectionHeading title="Competenza, materiali selezionati, un unico interlocutore" />
      <dl class="whyus__list">
        {
          whyUsPoints.map((point, index) => (
            <div class="whyus__item" data-reveal data-reveal-index={index}>
              <dt>{point.title}</dt>
              <dd>{point.description}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  .whyus__grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: var(--space-xl);
    align-items: start;
  }

  .whyus__image {
    position: sticky;
    top: calc(var(--header-height) + var(--space-md));
    aspect-ratio: 4 / 5;
    box-shadow: var(--shadow-lg);
  }

  .whyus__image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .whyus__item {
    padding-block: var(--space-md);
    border-top: 1px solid var(--color-border-strong);
  }

  .whyus__item dt {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.375rem;
    letter-spacing: -0.015em;
    color: var(--color-ink);
    margin-bottom: 0.35em;
  }

  .whyus__item dd {
    color: var(--color-ink-soft);
    max-width: 56ch;
  }

  @media (max-width: 900px) {
    .whyus__grid {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }

    .whyus__image {
      position: static;
      aspect-ratio: 4 / 3;
    }
  }
</style>
