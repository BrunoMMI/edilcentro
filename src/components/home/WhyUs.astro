---
import { Image } from 'astro:assets';
import SectionHeading from '@components/ui/SectionHeading.astro';
import { showroomPhoto } from '@data/showroom';
import { whyUsPoints } from '@data/content';

const photo = showroomPhoto('sala-consulenza-clienti');
---

<section class="whyus section section--alt">
  <div class="container whyus__grid">
    <div class="whyus__copy">
      <SectionHeading title="Competenza, materiali selezionati, un unico interlocutore" />
      <dl class="whyus__list">
        {
          whyUsPoints.map((point, index) => (
            <div class="whyus__item" data-reveal data-reveal-index={index}>
              <dt>{point.title}</dt>
              <dd>{point.description}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <figure class="whyus__image" data-reveal="fade">
      <Image src={photo.image} alt={photo.alt} widths={[480, 720, 960]} sizes="(max-width: 900px) 100vw, 44vw" />
    </figure>
  </div>
</section>

<style>
  .whyus__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
  }

  .whyus__list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg) var(--space-lg);
  }

  .whyus__item {
    padding-top: var(--space-sm);
    border-top: 2px solid var(--color-primary);
  }

  .whyus__item:nth-child(even) {
    border-top-color: var(--color-accent);
  }

  .whyus__item dt {
    font-family: var(--font-display);
    font-size: 1.375rem;
    color: var(--color-ink);
    line-height: 1.2;
    margin-bottom: var(--space-2xs);
  }

  .whyus__item dd {
    color: var(--color-ink-soft);
    font-size: 1rem;
  }

  .whyus__image :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  @media (max-width: 1000px) {
    .whyus__grid {
      grid-template-columns: 1fr;
    }

    .whyus__image :global(img) {
      aspect-ratio: 16 / 10;
    }
  }

  @media (max-width: 640px) {
    .whyus__list {
      grid-template-columns: 1fr;
    }
  }
</style>
