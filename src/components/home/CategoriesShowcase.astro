---
import SectionHeading from '@components/ui/SectionHeading.astro';
import { categories } from '@data/categories';
import { brandGroups } from '@data/brands';
---

<section class="categories section section--alt">
  <div class="container">
    <div class="categories__head">
      <SectionHeading
        title="Otto categorie, un unico showroom"
        subtitle="Dai pavimenti alla rubinetteria: tutto ciò che serve per progettare bagno e casa, con i marchi che trattiamo."
      />
      <a href="/prodotti/" class="btn btn-secondary" data-reveal>Tutti i prodotti e i marchi</a>
    </div>

    <ul class="categories__grid tile-grid">
      {
        categories.map((category, index) => {
          const count = brandGroups[category.brandGroup]?.length ?? 0;
          return (
            <li data-reveal data-reveal-index={index % 4}>
              <a href={`/prodotti/#${category.slug}`} class="cat-tile">
                <h3>{category.title}</h3>
                <p>{category.shortDescription}</p>
                <span class="cat-tile__meta">
                  {count} marchi
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="square" />
                  </svg>
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .categories__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .categories__head :global(.section-head),
  .categories__head > .btn {
    margin-bottom: var(--space-lg);
  }

  .categories__grid {
    grid-template-columns: repeat(4, 1fr);
  }

  .categories__grid li {
    display: flex;
  }

  .cat-tile {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    width: 100%;
    min-height: 260px;
    padding: var(--space-md);
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    transition: background-color var(--transition-base), transform var(--transition-base),
      box-shadow var(--transition-base);
  }

  .cat-tile p {
    font-size: 1rem;
  }

  .cat-tile__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    padding-top: var(--space-sm);
    font-weight: 650;
    color: var(--color-primary);
  }

  .cat-tile__meta svg {
    transition: transform var(--transition-base);
  }

  .cat-tile:hover {
    background: var(--color-primary-dark);
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .cat-tile:hover svg {
    transform: translateX(4px);
  }

  .cat-tile:hover h3,
  .cat-tile:hover .cat-tile__meta {
    color: #fff;
  }

  .cat-tile:hover p {
    color: rgba(255, 255, 255, 0.85);
  }

  @media (max-width: 1100px) {
    .categories__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .categories__grid {
      grid-template-columns: 1fr;
    }

    .cat-tile {
      min-height: 0;
    }
  }
</style>
