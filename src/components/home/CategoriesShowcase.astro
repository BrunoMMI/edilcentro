---
import { Image } from 'astro:assets';
import SectionHeading from '@components/ui/SectionHeading.astro';
import { categories } from '@data/categories';
---

<section class="categories section section--alt">
  <div class="container">
    <div class="categories__head">
      <SectionHeading
        eyebrow="Catalogo prodotti"
        title="Otto categorie, un unico showroom"
        subtitle="Dai pavimenti alla rubinetteria, tutto ciò che serve per progettare bagno e casa con materiali selezionati."
      />
      <a href="/prodotti/" class="btn btn-secondary categories__cta" data-reveal>Vedi tutti i prodotti</a>
    </div>

    <div class="categories__grid">
      {
        categories.map((category, index) => (
          <a
            href={`/prodotti/#${category.slug}`}
            class="cat-card"
            data-reveal
            data-reveal-index={index % 4}
          >
            <div class="cat-card__media">
              <Image
                src={category.image}
                alt={`${category.title} — Edil Centro`}
                widths={[320, 480]}
                sizes="(max-width: 640px) 90vw, 300px"
              />
            </div>
            <div class="cat-card__body">
              <h3>{category.title}</h3>
              <p>{category.shortDescription}</p>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .categories__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .categories__cta {
    flex-shrink: 0;
    margin-bottom: var(--space-lg);
  }

  .categories__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
  }

  .cat-card {
    display: block;
    background: var(--color-surface);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .cat-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-md);
  }

  .cat-card__media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .cat-card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .cat-card:hover .cat-card__media :global(img) {
    transform: scale(1.06);
  }

  .cat-card__body {
    padding: var(--space-sm) var(--space-sm) var(--space-md);
  }

  .cat-card__body h3 {
    font-size: 1.125rem;
    margin-bottom: 0.35em;
  }

  .cat-card__body p {
    font-size: 0.875rem;
    line-height: 1.5;
  }

  @media (max-width: 1080px) {
    .categories__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .categories__grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-sm);
    }

    .cat-card__body {
      padding: var(--space-xs);
    }

    .cat-card__body h3 {
      font-size: 1rem;
    }

    .cat-card__body p {
      display: none;
    }
  }
</style>
