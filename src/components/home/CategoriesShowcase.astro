---
import { Image } from 'astro:assets';
import SectionHeading from '@components/ui/SectionHeading.astro';
import { categories } from '@data/categories';
import { categoryImage } from '@data/category-images';
import { brandGroups } from '@data/brands';
---

<section class="categories section">
  <div class="container">
    <div class="categories__head">
      <SectionHeading
        title="Otto categorie, un unico showroom"
        subtitle="Dai pavimenti alla rubinetteria: tutto ciò che serve per progettare bagno e casa, con i marchi che trattiamo."
      />
      <a href="/prodotti/" class="btn btn-secondary" data-reveal>Tutti i prodotti e i marchi</a>
    </div>

    <ul class="categories__grid">
      {
        categories.map((category, index) => {
          const count = brandGroups[category.brandGroup]?.length ?? 0;
          const photo = categoryImage(category.slug);
          return (
            <li data-reveal data-reveal-index={index % 4}>
              <a href={`/prodotti/#${category.slug}`} class="cat-tile">
                <Image
                  src={photo.image}
                  alt=""
                  widths={[360, 560, 800]}
                  sizes="(max-width: 560px) 100vw, (max-width: 1000px) 50vw, 25vw"
                />
                <span class="cat-tile__body">
                  <h3>{category.title}</h3>
                  <span class="cat-tile__meta">{count} marchi</span>
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .categories__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .categories__head :global(.section-head) {
    margin-bottom: 0;
  }

  .categories__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--grout);
  }

  .cat-tile {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--color-primary-dark);
    color: #fff;
  }

  .cat-tile :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cat-tile::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(8, 28, 46, 0.85) 0%, rgba(8, 28, 46, 0.1) 55%, transparent);
  }

  .cat-tile:hover :global(img),
  .cat-tile:focus-visible :global(img) {
    transform: scale(1.06);
  }

  .cat-tile__body {
    position: absolute;
    z-index: 1;
    left: 0;
    right: 0;
    bottom: 0;
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .cat-tile h3 {
    color: #fff;
    font-size: clamp(1.375rem, 2vw, 1.75rem);
  }

  .cat-tile__meta {
    font-size: 0.9375rem;
    color: rgba(255, 255, 255, 0.85);
  }

  @media (max-width: 1000px) {
    .categories__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .categories__grid {
      grid-template-columns: 1fr 1fr;
      gap: 8px;
    }

    .cat-tile {
      aspect-ratio: 1;
    }

    .cat-tile__body {
      padding: var(--space-sm);
    }
  }
</style>
