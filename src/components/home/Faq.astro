---
import SectionHeading from '@components/ui/SectionHeading.astro';
import { faqItems } from '@data/content';
---

<section class="faq section">
  <div class="container faq__grid">
    <SectionHeading
      title="Domande frequenti"
      subtitle="Le risposte alle richieste che riceviamo più spesso. Per tutto il resto, chiamaci o passa in showroom."
    />

    <div class="faq__list">
      {
        faqItems.map((item) => (
          <details class="faq__item">
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }

  .faq__grid :global(.section-head) {
    position: sticky;
    top: calc(var(--header-height) + var(--space-md));
  }

  .faq__item {
    border-top: 1px solid var(--color-border);
  }

  .faq__item:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .faq__item summary {
    position: relative;
    display: block;
    padding: var(--space-md) 3rem var(--space-md) 0;
    font-family: var(--font-display);
    font-size: 1.1875rem;
    line-height: 1.35;
    color: var(--color-ink);
    cursor: pointer;
    list-style: none;
    min-height: 44px;
  }

  .faq__item summary::-webkit-details-marker {
    display: none;
  }

  .faq__item summary::before,
  .faq__item summary::after {
    content: '';
    position: absolute;
    right: 0.5rem;
    top: 50%;
    width: 16px;
    height: 2px;
    margin-top: -1px;
    background: var(--color-primary);
    transition: transform var(--transition-base);
  }

  .faq__item summary::after {
    transform: rotate(90deg);
  }

  .faq__item[open] summary::after {
    transform: rotate(0);
  }

  .faq__item p {
    padding: 0 3rem var(--space-md) 0;
  }

  @media (max-width: 900px) {
    .faq__grid {
      grid-template-columns: 1fr;
    }

    .faq__grid :global(.section-head) {
      position: static;
    }
  }
</style>
