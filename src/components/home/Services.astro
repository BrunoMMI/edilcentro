---
import { Image } from 'astro:assets';
import SectionHeading from '@components/ui/SectionHeading.astro';
import { services } from '@data/content';
import { showroomPhoto } from '@data/showroom';

const photo = showroomPhoto('ufficio-consulenza');

const icons: Record<string, string> = {
  consulenza: 'M12 3 3 8v3h18V8l-9-5Zm-7 9v8h4v-6h6v6h4v-8H5Z',
  render: 'M4 4h16v12H4V4Zm2 15h12v2H6v-2Zm5-9 2 4-2 4-2-4 2-4Z',
  consegna: 'M3 7h11v7H3V7Zm11 2h4l3 3v2h-7V9ZM6.5 20a2 2 0 1 1 0-4 2 2 0 0 1 0 4Zm11 0a2 2 0 1 1 0-4 2 2 0 0 1 0 4Z',
  assistenza: 'M12 2a5 5 0 0 1 5 5v2a5 5 0 0 1-2 4v2l4 2v3H5v-3l4-2v-2a5 5 0 0 1-2-4V7a5 5 0 0 1 5-5Z',
};
---

<section class="services section">
  <div class="container services__grid">
    <div class="services__intro">
      <SectionHeading
        title="Un servizio completo, dal progetto alla posa"
        subtitle="Non solo vendita di materiali: un percorso di consulenza pensato per accompagnarti in ogni fase."
      />
      <figure class="services__photo" data-reveal="fade">
        <Image src={photo.image} alt={photo.alt} widths={[480, 720, 960]} sizes="(max-width: 900px) 100vw, 40vw" />
      </figure>
    </div>

    <ul class="services__list">
      {
        services.map((service, index) => (
          <li class="service" data-reveal data-reveal-index={index}>
            <span class="service__icon" aria-hidden="true">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor">
                <path d={icons[service.icon]} />
              </svg>
            </span>
            <div>
              <h3>{service.title}</h3>
              <p>{service.description}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .services__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }

  .services__photo :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .services__list {
    display: flex;
    flex-direction: column;
  }

  .service {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-md);
    padding-block: var(--space-md);
    border-top: 1px solid var(--color-border);
  }

  .service:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .service__icon {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    color: var(--color-primary);
    background: var(--color-primary-light);
  }

  .service h3 {
    margin-bottom: var(--space-3xs);
  }

  @media (max-width: 900px) {
    .services__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .service {
      grid-template-columns: 1fr;
      gap: var(--space-sm);
    }
  }
</style>
