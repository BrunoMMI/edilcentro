---
import { Image } from 'astro:assets';
import SectionHeading from '@components/ui/SectionHeading.astro';
import { projectImages } from '@data/projects';

const preview = projectImages.filter((p) => ['marmo-01', 'cementato-01', 'geometrico-01', 'floreale-01', 'pennellata-01'].some((k) => p.image.src.includes(k))).slice(0, 5);
const featured = preview.length >= 5 ? preview : projectImages.slice(0, 5);
---

<section class="projects-preview section">
  <div class="container">
    <div class="projects-preview__head">
      <SectionHeading
        eyebrow="Progetti e render"
        title="Bagni pensati, prima ancora di essere costruiti"
        subtitle="Cinque stili, un metodo: render 3D fotorealistici per visualizzare ogni ambiente prima dei lavori."
      />
      <a href="/progetti/" class="btn btn-secondary" data-reveal>Sfoglia la galleria</a>
    </div>

    <div class="projects-preview__grid">
      {
        featured.map((item, index) => (
          <a href="/progetti/" class:list={['pp-item', `pp-item--${index}`]} data-reveal data-reveal-index={index}>
            <Image src={item.image} alt={item.alt} widths={[320, 520, 720]} sizes="(max-width: 900px) 60vw, 22vw" />
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .projects-preview__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .projects-preview__head .btn {
    margin-bottom: var(--space-lg);
  }

  .projects-preview__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 180px;
    gap: var(--space-sm);
  }

  .pp-item {
    display: block;
    border-radius: var(--radius-md);
    overflow: hidden;
    position: relative;
  }

  .pp-item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .pp-item:hover :global(img) {
    transform: scale(1.05);
  }

  .pp-item--0 {
    grid-column: span 2;
    grid-row: span 2;
  }

  .pp-item--3 {
    grid-column: span 2;
  }

  @media (max-width: 900px) {
    .projects-preview__grid {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 160px;
    }

    .pp-item--0 {
      grid-column: span 2;
    }

    .pp-item--3 {
      grid-column: span 1;
    }
  }
</style>
