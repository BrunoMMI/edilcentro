---
import { Image } from 'astro:assets';
import { showroomPhoto } from '@data/showroom';
import { foundedYear, mainLocation } from '@data/site';

const slides = [
  { photo: showroomPhoto('facciata-sanitari-arredi'), label: 'Lo showroom di Pace del Mela', href: '/showroom/', cta: 'Scopri lo showroom', position: '50% 60%' },
  { photo: showroomPhoto('galleria-coperta-showroom'), label: 'Pavimenti e rivestimenti', href: '/prodotti/#pavimenti', cta: 'Vedi i pavimenti', position: '50% 55%' },
  { photo: showroomPhoto('rubinetteria-e-sanitari-esposti'), label: 'Sanitari e rubinetteria', href: '/prodotti/#sanitari', cta: 'Vedi i sanitari', position: '50% 55%' },
  { photo: showroomPhoto('corridoio-lastre-gres'), label: 'Lastre in gres di grande formato', href: '/prodotti/#rivestimenti', cta: 'Vedi i rivestimenti', position: '50% 55%' },
  { photo: showroomPhoto('rivestimenti-decorati-floreali'), label: 'Decori e rivestimenti', href: '/prodotti/#rivestimenti', cta: 'Vedi i rivestimenti', position: '40% 50%' },
  { photo: showroomPhoto('lastre-effetto-marmo'), label: 'Effetto marmo e campionari', href: '/prodotti/#pavimenti', cta: 'Vedi i pavimenti', position: '50% 55%' },
];
---

<section class="hero" data-hero aria-roledescription="carosello" aria-label="Immagini dello showroom">
  <div class="hero__slides">
    {
      slides.map((slide, index) => (
        <div
          class:list={['hero__slide', { 'is-active': index === 0 }]}
          data-hero-slide
          role="group"
          aria-roledescription="diapositiva"
          aria-label={`${index + 1} di ${slides.length}: ${slide.label}`}
          aria-hidden={index === 0 ? 'false' : 'true'}
        >
          <Image
            src={slide.photo.image}
            alt={slide.photo.alt}
            widths={[768, 1200, 1600, 2200]}
            sizes="100vw"
            loading={index === 0 ? 'eager' : 'lazy'}
            fetchpriority={index === 0 ? 'high' : 'auto'}
            style={`object-position: ${slide.position}`}
          />
        </div>
      ))
    }
  </div>

  <div class="hero__shade" aria-hidden="true"></div>

  <div class="container hero__content">
    <div class="hero__copy">
      <h1>Ceramiche, sanitari e arredo bagno dal {foundedYear}</h1>
      <p class="hero__caption" aria-live="off">
        {
          slides.map((slide, index) => (
            <a href={slide.href} class:list={['hero__caption-link', { 'is-active': index === 0 }]} data-hero-caption tabindex={index === 0 ? undefined : -1}>
              {slide.label}: <span>{slide.cta}</span>
            </a>
          ))
        }
      </p>
      <div class="hero__actions">
        <a href="/prodotti/" class="btn btn-light">Guarda i prodotti</a>
        <a href={mainLocation.phoneHref} class="btn btn-outline-light">Chiama {mainLocation.phone}</a>
      </div>
    </div>

    <div class="hero__controls">
      <ol class="hero__bars" aria-label="Scegli l'immagine">
        {
          slides.map((slide, index) => (
            <li>
              <button
                type="button"
                data-hero-dot
                class:list={['hero__bar', { 'is-active': index === 0 }]}
                aria-label={`Vai all'immagine ${index + 1}: ${slide.label}`}
                aria-current={index === 0 ? 'true' : undefined}
              >
                <span></span>
              </button>
            </li>
          ))
        }
      </ol>
      <div class="hero__buttons">
        <button type="button" class="hero__btn" data-hero-toggle aria-label="Metti in pausa lo slideshow" aria-pressed="false">
          <svg class="icon-pause" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 4h4v16H6V4Zm8 0h4v16h-4V4Z"></path></svg>
          <svg class="icon-play" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4v16l13-8L7 4Z"></path></svg>
        </button>
        <button type="button" class="hero__btn" data-hero-prev aria-label="Immagine precedente">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m15 5-7 7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </button>
        <button type="button" class="hero__btn" data-hero-next aria-label="Immagine successiva">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m9 5 7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  import '../../scripts/hero-slider.ts';
</script>

<style>
  .hero {
    --hero-interval: 6500ms;
    position: relative;
    isolation: isolate;
    height: calc(100svh - var(--header-height));
    min-height: 520px;
    max-height: 1000px;
    overflow: hidden;
    background: var(--color-primary-dark);
    color: #fff;
  }

  .hero__slides,
  .hero__slide {
    position: absolute;
    inset: 0;
  }

  .hero__slide {
    opacity: 0;
    transition: opacity 1400ms ease;
  }

  .hero__slide.is-active {
    opacity: 1;
    z-index: 1;
  }

  .hero__slide :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1);
  }

  /* Lenta spinta di zoom: solo sulla diapositiva attiva */
  .hero__slide.is-active :global(img) {
    animation: hero-zoom calc(var(--hero-interval) + 1800ms) ease-out forwards;
  }

  .hero[data-paused='true'] .hero__slide.is-active :global(img) {
    animation-play-state: paused;
  }

  @keyframes hero-zoom {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(1.07);
    }
  }

  .hero__shade {
    position: absolute;
    inset: 0;
    z-index: 2;
    background:
      linear-gradient(0deg, rgba(8, 28, 46, 0.82) 0%, rgba(8, 28, 46, 0.45) 38%, rgba(8, 28, 46, 0.08) 70%),
      linear-gradient(90deg, rgba(8, 28, 46, 0.35), transparent 55%);
  }

  .hero__content {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--space-lg);
    padding-bottom: clamp(1.5rem, 4vw, 3rem);
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-md);
  }

  .hero__copy h1 {
    color: #fff;
    max-width: 16ch;
    text-shadow: 0 2px 30px rgba(0, 0, 0, 0.35);
  }

  .hero__caption {
    position: relative;
    display: grid;
    min-height: 1.75em;
    font-size: clamp(1rem, 1.5vw, 1.25rem);
    color: #fff;
  }

  .hero__caption-link {
    grid-area: 1 / 1;
    color: #fff;
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: opacity 600ms ease, transform 600ms ease, visibility 0s linear 600ms;
  }

  .hero__caption-link span {
    border-bottom: 1.5px solid rgba(255, 255, 255, 0.7);
    font-weight: 600;
  }

  .hero__caption-link:hover span {
    border-bottom-color: #fff;
  }

  .hero__caption-link.is-active {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition: opacity 600ms ease 300ms, transform 600ms ease 300ms;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .hero__controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding-top: var(--space-sm);
    border-top: 1px solid rgba(255, 255, 255, 0.25);
  }

  .hero__bars {
    display: flex;
    flex: 1;
    gap: 6px;
    max-width: 30rem;
  }

  .hero__bars li {
    flex: 1;
  }

  .hero__bar {
    display: block;
    width: 100%;
    height: 24px;
    padding: 10px 0;
  }

  .hero__bar span {
    position: relative;
    display: block;
    height: 3px;
    background: rgba(255, 255, 255, 0.35);
    overflow: hidden;
  }

  .hero__bar span::after {
    content: '';
    position: absolute;
    inset: 0;
    background: #fff;
    transform: scaleX(0);
    transform-origin: left;
  }

  .hero__bar.is-active span::after {
    animation: hero-progress var(--hero-interval) linear forwards;
  }

  .hero[data-paused='true'] .hero__bar.is-active span::after {
    animation-play-state: paused;
  }

  .hero[data-static='true'] .hero__bar.is-active span::after {
    animation: none;
    transform: scaleX(1);
  }

  @keyframes hero-progress {
    to {
      transform: scaleX(1);
    }
  }

  .hero__buttons {
    display: flex;
    gap: var(--space-2xs);
  }

  .hero__btn {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1.5px solid rgba(255, 255, 255, 0.7);
    border-radius: 50%;
    color: #fff;
    transition: background-color var(--transition-base), color var(--transition-base);
  }

  .hero__btn:hover {
    background: #fff;
    color: var(--color-primary-dark);
  }

  .hero__btn .icon-play,
  .hero__btn[aria-pressed='true'] .icon-pause {
    display: none;
  }

  .hero__btn[aria-pressed='true'] .icon-play {
    display: block;
  }

  @media (max-width: 900px) {
    .hero {
      min-height: 480px;
    }

    .hero__copy h1 {
      max-width: 14ch;
    }
  }

  @media (max-width: 560px) {
    .hero {
      min-height: 560px;
    }

    .hero__actions .btn {
      flex: 1 1 100%;
    }

    .hero__bars {
      max-width: none;
    }

    .hero__btn {
      width: 44px;
      height: 44px;
    }

    .hero__btn:first-child {
      display: none;
    }
  }

  @media (max-height: 520px) and (orientation: landscape) {
    .hero {
      min-height: 420px;
    }

    .hero__copy {
      gap: var(--space-xs);
    }

    .hero__copy h1 {
      font-size: 2rem;
      max-width: 24ch;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__slide.is-active :global(img) {
      animation: none;
    }
  }
</style>
