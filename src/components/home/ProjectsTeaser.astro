---
import { Image } from 'astro:assets';
import SectionHeading from '@components/ui/SectionHeading.astro';
import { projectImages, projectStyles } from '@data/projects';

const tiles = projectStyles.map((style) => ({
  ...style,
  cover: projectImages.find((p) => p.style === style.slug)!,
}));
---

<section class="teaser section">
  <div class="container">
    <div class="teaser__head">
      <SectionHeading
        title="Bagni pensati, prima ancora di essere costruiti"
        subtitle="Cinque stili, un metodo: render 3D fotorealistici per visualizzare ogni ambiente prima dei lavori. Li trovi nella sezione Progetti."
      />
      <a href="/progetti/" class="btn btn-primary" data-reveal>Vai ai progetti</a>
    </div>

    <ul class="teaser__styles">
      {
        tiles.map((style, index) => (
          <li data-reveal data-reveal-index={index}>
            <a href={`/progetti/#${style.slug}`} class="style-tile">
              <Image src={style.cover.image} alt="" widths={[360, 560, 800]} sizes="(max-width: 700px) 100vw, 33vw" />
              <span class="style-tile__body">
                <h3>{style.label}</h3>
                <p>{style.description}</p>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .teaser__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .teaser__head :global(.section-head) {
    margin-bottom: 0;
  }

  .teaser__styles {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: var(--grout);
  }

  .teaser__styles li {
    grid-column: span 2;
  }

  .teaser__styles li:nth-child(n + 4) {
    grid-column: span 3;
  }

  .style-tile {
    position: relative;
    display: block;
    height: 100%;
    min-height: 280px;
    overflow: hidden;
    background: var(--color-primary-dark);
    color: #fff;
  }

  .style-tile :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .style-tile::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(8, 28, 46, 0.88) 0%, rgba(8, 28, 46, 0.15) 60%, transparent);
  }

  .style-tile:hover :global(img) {
    transform: scale(1.06);
  }

  .style-tile__body {
    position: absolute;
    z-index: 1;
    inset: auto 0 0 0;
    padding: var(--space-md);
  }

  .style-tile h3 {
    color: #fff;
    margin-bottom: var(--space-3xs);
  }

  .style-tile p {
    color: rgba(255, 255, 255, 0.88);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  @media (max-width: 900px) {
    .teaser__styles {
      grid-template-columns: repeat(2, 1fr);
    }

    .teaser__styles li,
    .teaser__styles li:nth-child(n + 4) {
      grid-column: span 1;
    }

    .teaser__styles li:last-child {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 560px) {
    .teaser__styles {
      grid-template-columns: 1fr;
    }

    .teaser__styles li,
    .teaser__styles li:last-child {
      grid-column: 1;
    }

    .style-tile {
      min-height: 240px;
    }
  }
</style>
