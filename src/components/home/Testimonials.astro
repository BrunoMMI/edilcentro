---
import SectionHeading from '@components/ui/SectionHeading.astro';
import { testimonials } from '@data/content';
---

<section class="testimonials section section--alt">
  <div class="container">
    <SectionHeading title="Le parole di chi ha lavorato con noi" />

    <ul class="testimonials__grid tile-grid">
      {
        testimonials.map((item, index) => (
          <li data-reveal data-reveal-index={index}>
            <figure class="testimonial">
              <blockquote>
                <p>{item.quote}</p>
              </blockquote>
              <figcaption>
                <span class="testimonial__name">{item.name}</span>
                <span class="testimonial__role">{item.role}</span>
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .testimonials__grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .testimonials__grid li {
    display: flex;
  }

  .testimonial {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-md);
    width: 100%;
    padding: var(--space-md);
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  .testimonial::before {
    content: '“';
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    padding-top: 0.2em;
    background: var(--color-accent-dark);
    color: #fff;
    border-radius: 50%;
    font-family: var(--font-display);
    font-size: 2.25rem;
    font-weight: 800;
    line-height: 1;
  }

  .testimonial blockquote p {
    font-family: var(--font-display);
    font-size: 1.1875rem;
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }

  .testimonial figcaption {
    display: flex;
    flex-direction: column;
  }

  .testimonial__name {
    font-weight: 700;
    color: var(--color-ink);
  }

  .testimonial__role {
    font-size: 0.9375rem;
    color: var(--color-ink-faint);
  }

  @media (max-width: 900px) {
    .testimonials__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
