---
import SectionHeading from '@components/ui/SectionHeading.astro';
import { testimonials } from '@data/content';
---

<section class="testimonials section section--alt">
  <div class="container">
    <SectionHeading title="Le parole di chi ha lavorato con noi" />

    <ul class="testimonials__grid">
      {
        testimonials.map((item, index) => (
          <li data-reveal data-reveal-index={index}>
            <figure class="testimonial">
              <blockquote>
                <p>{item.quote}</p>
              </blockquote>
              <figcaption>
                <span class="testimonial__name">{item.name}</span>
                <span class="testimonial__role">{item.role}</span>
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .testimonials__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }

  .testimonial {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-md);
    height: 100%;
    padding: var(--space-lg) var(--space-md) var(--space-md);
    background: #fff;
    border-top: 3px solid var(--color-primary);
  }

  .testimonials__grid li:nth-child(2) .testimonial {
    border-top-color: var(--color-accent);
  }

  .testimonial blockquote p {
    font-family: var(--font-display);
    font-size: 1.1875rem;
    line-height: 1.55;
    color: var(--color-ink);
  }

  .testimonial figcaption {
    display: flex;
    flex-direction: column;
  }

  .testimonial__name {
    font-weight: 650;
    color: var(--color-ink);
  }

  .testimonial__role {
    font-size: 0.9375rem;
    color: var(--color-ink-faint);
  }

  @media (max-width: 900px) {
    .testimonials__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
