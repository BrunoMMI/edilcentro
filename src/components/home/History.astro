---
import { yearsOfActivity, foundedYear } from '@data/site';
import { allBrands } from '@data/brands';
import { categories } from '@data/categories';

const brandCount = Math.floor(allBrands.length / 5) * 5;

const stats = [
  { value: yearsOfActivity, suffix: '+', label: 'Anni di attività, dal ' + foundedYear },
  { value: brandCount, suffix: '+', label: 'Brand partner selezionati' },
  { value: categories.length, suffix: '', label: 'Categorie di prodotto in showroom' },
  { value: 2, suffix: '', label: 'Sedi a Pace del Mela: showroom e ferramenta' },
];
---

<section class="history section section--dark">
  <div class="container history__grid">
    <div class="history__copy" data-reveal>
      <p class="eyebrow">Mezzo secolo di esperienza</p>
      <h2>Una storia che continua dal {foundedYear}</h2>
      <p class="lede">
        Da oltre {yearsOfActivity} anni Edil Centro affianca famiglie e imprese della provincia di
        Messina nella scelta di materiali per l'edilizia e l'arredo bagno, con la stessa cura per
        il dettaglio che ha caratterizzato l'attività fin dagli esordi come Ceramiche Valenti.
      </p>
    </div>

    <dl class="history__stats">
      {
        stats.map((stat, index) => (
          <div class="stat" data-reveal data-reveal-index={index}>
            <dt>
              <span data-counter={stat.value}>0</span>{stat.suffix}
            </dt>
            <dd>{stat.label}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<script>
  import '../../scripts/counters.ts';
</script>

<style>
  .history__grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: var(--space-2xl);
    align-items: center;
  }

  .history__copy .lede {
    margin-top: var(--space-sm);
  }

  .history__stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg);
  }

  .stat dt {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: 600;
    color: #fff;
  }

  .stat dd {
    margin-top: 0.35em;
    font-size: 0.875rem;
    color: rgba(243, 241, 236, 0.7);
    max-width: 22ch;
  }

  @media (max-width: 900px) {
    .history__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .history__stats {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-md);
    }
  }
</style>
