---
import { getImage } from 'astro:assets';
import { yearsOfActivity, foundedYear } from '@data/site';
import { allBrands } from '@data/brands';
import { categories } from '@data/categories';
import { showroomPhoto } from '@data/showroom';

const bg = await getImage({ src: showroomPhoto('galleria-coperta-decori').image, width: 2000, format: 'webp' });
const brandCount = Math.floor(allBrands.length / 5) * 5;

const stats = [
  { value: yearsOfActivity, suffix: '+', label: 'anni di attività, dal ' + foundedYear },
  { value: brandCount, suffix: '+', label: 'marchi selezionati' },
  { value: categories.length, suffix: '', label: 'categorie di prodotto in showroom' },
  { value: 2, suffix: '', label: 'sedi a Pace del Mela: showroom e ferramenta' },
];
---

<section class="history photo-band photo-band--fixed section" style={`background-image: url(${bg.src})`}>
  <div class="container history__inner">
    <div class="history__copy" data-reveal>
      <h2>Vi aiutiamo a costruire i vostri spazi</h2>
      <p class="lede">
        Da oltre {yearsOfActivity} anni Edil Centro affianca famiglie e imprese della provincia di Messina nella
        scelta di materiali per l'edilizia e l'arredo bagno, con la stessa cura per il dettaglio che ha
        caratterizzato l'attività fin dagli esordi come Ceramiche Valenti.
      </p>
    </div>

    <dl class="history__stats">
      {
        stats.map((stat, index) => (
          <div class="stat" data-reveal data-reveal-index={index}>
            <dt>
              <span data-counter={stat.value}>{stat.value}</span>{stat.suffix}
            </dt>
            <dd>{stat.label}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<script>
  import '../../scripts/counters.ts';
</script>

<style>
  .history {
    padding-block: clamp(4rem, 10vw, 8rem);
  }

  .history__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xl);
    text-align: center;
  }

  .history__copy {
    max-width: 48rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
  }

  .history__copy h2 {
    color: #fff;
  }

  .history__stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    width: 100%;
    border-top: 1px solid rgba(255, 255, 255, 0.35);
  }

  .stat {
    padding: var(--space-md) var(--space-sm) 0;
  }

  .stat + .stat {
    border-left: 1px solid rgba(255, 255, 255, 0.25);
  }

  .stat dt {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 4rem);
    line-height: 1;
    color: #fff;
  }

  .stat dd {
    margin-top: var(--space-2xs);
    margin-inline: auto;
    max-width: 18ch;
    font-size: 0.9375rem;
    color: rgba(255, 255, 255, 0.85);
  }

  @media (max-width: 800px) {
    .history__stats {
      grid-template-columns: repeat(2, 1fr);
      row-gap: var(--space-md);
    }

    .stat:nth-child(odd) {
      border-left: 0;
    }
  }
</style>
