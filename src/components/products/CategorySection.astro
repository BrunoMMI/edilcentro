---
import { Image } from 'astro:assets';
import type { ProductCategory } from '@data/categories';
import { categoryImage } from '@data/category-images';
import { brandGroups } from '@data/brands';

interface Props {
  category: ProductCategory;
  index?: number;
}

const { category, index = 0 } = Astro.props;
const brands = brandGroups[category.brandGroup] ?? [];
const photo = categoryImage(category.slug);
---

<article id={category.slug} class:list={['cat-section', { 'cat-section--flip': index % 2 === 1 }]}>
  <div class="cat-section__inner">
    <figure class="cat-section__photo" data-reveal="fade">
      <Image src={photo.image} alt={photo.alt} widths={[480, 720, 1000]} sizes="(max-width: 900px) 100vw, 50vw" loading="lazy" />
    </figure>

    <div class="cat-section__copy">
      <h2>{category.title}</h2>
      <p class="cat-section__text">{category.description}</p>
      <a href="/contatti/" class="btn btn-primary">Chiedi informazioni su {category.title.toLowerCase()}</a>
    </div>
  </div>

  {
    brands.length > 0 && (
      <div class="cat-section__brands">
        <h3>
          Marchi disponibili <span>({brands.length})</span>
        </h3>
        <ul class="cat-section__logos" aria-label={`Marchi per ${category.title.toLowerCase()}`}>
          {brands.map((brand) => (
            <li>
              <Image src={brand.logo} alt={brand.name} height={64} loading="lazy" />
            </li>
          ))}
        </ul>
      </div>
    )
  }
</article>

<style>
  .cat-section {
    padding-block: var(--space-xl);
  }

  .cat-section + .cat-section {
    border-top: 1px solid var(--color-border);
  }

  .cat-section__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
  }

  .cat-section--flip .cat-section__photo {
    order: 2;
  }

  .cat-section__photo :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .cat-section__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-md);
  }

  .cat-section__text {
    font-size: 1.0625rem;
  }

  .cat-section__brands {
    margin-top: var(--space-xl);
  }

  .cat-section__brands h3 {
    font-size: 1.25rem;
    margin-bottom: var(--space-sm);
  }

  .cat-section__brands h3 span {
    color: var(--color-ink-faint);
    font-family: var(--font-body);
    font-size: 1rem;
  }

  .cat-section__logos {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    border-top: 1px solid var(--color-border);
    border-left: 1px solid var(--color-border);
  }

  .cat-section__logos li {
    display: grid;
    place-items: center;
    height: 88px;
    padding: 12px 16px;
    background: #fff;
    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .cat-section__logos :global(img) {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 52px;
    object-fit: contain;
  }

  @media (max-width: 900px) {
    .cat-section {
      padding-block: var(--space-lg);
    }

    .cat-section__inner {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }

    .cat-section--flip .cat-section__photo {
      order: 0;
    }

    .cat-section__brands {
      margin-top: var(--space-lg);
    }
  }

  @media (max-width: 480px) {
    .cat-section__logos {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
