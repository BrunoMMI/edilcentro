---
import { Image } from 'astro:assets';
import type { ProductCategory } from '@data/categories';
import { brandGroups } from '@data/brands';

interface Props {
  category: ProductCategory;
}

const { category } = Astro.props;
const brands = brandGroups[category.brandGroup] ?? [];
---

<article id={category.slug} class="cat-section">
  <div class="cat-section__copy">
    <h2>{category.title}</h2>
    <p class="cat-section__text">{category.description}</p>
    <a href="/contatti/" class="btn btn-primary">Chiedi informazioni su {category.title.toLowerCase()}</a>
  </div>

  {
    brands.length > 0 && (
      <div class="cat-section__brands">
        <h3>
          Marchi disponibili <span>({brands.length})</span>
        </h3>
        <ul class="cat-section__logos" aria-label={`Marchi per ${category.title.toLowerCase()}`}>
          {brands.map((brand) => (
            <li>
              <Image src={brand.logo} alt={brand.name} width={220} loading="lazy" />
            </li>
          ))}
        </ul>
      </div>
    )
  }
</article>

<style>
  .cat-section {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: var(--space-xl);
    padding-block: var(--space-xl);
    border-top: 1px solid var(--color-border-strong);
  }

  .cat-section__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-md);
    align-self: start;
    position: sticky;
    top: calc(var(--header-height) + 72px);
  }

  .cat-section__text {
    font-size: 1.0625rem;
  }

  .cat-section__brands h3 {
    font-size: 1.125rem;
    margin-bottom: var(--space-sm);
  }

  .cat-section__brands h3 span {
    color: var(--color-ink-faint);
    font-weight: 500;
  }

  .cat-section__logos {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(132px, 1fr));
    gap: var(--grout);
  }

  .cat-section__logos li {
    display: grid;
    place-items: center;
    height: 88px;
    padding: 12px 16px;
    background: var(--color-surface);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
  }

  .cat-section__logos :global(img) {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 52px;
    object-fit: contain;
  }

  @media (max-width: 900px) {
    .cat-section {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
      padding-block: var(--space-lg);
    }

    .cat-section__copy {
      position: static;
    }
  }

  @media (max-width: 480px) {
    .cat-section__logos {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
