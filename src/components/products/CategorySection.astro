---
import { Image } from 'astro:assets';
import type { ProductCategory } from '@data/categories';
import { brandGroups } from '@data/brands';

interface Props {
  category: ProductCategory;
  index: number;
}

const { category, index } = Astro.props;
const brands = brandGroups[category.brandGroup] ?? [];
const reversed = index % 2 === 1;
---

<article id={category.slug} class:list={['cat-section', { 'cat-section--reverse': reversed }]}>
  <div class="cat-section__media" data-reveal data-reveal="scale">
    <Image
      src={category.image}
      alt={`${category.title} — materiali disponibili da Edil Centro`}
      widths={[420, 640, 900]}
      sizes="(max-width: 900px) 90vw, 44vw"
    />
  </div>
  <div class="cat-section__copy">
    <h2 data-reveal>{category.title}</h2>
    <p class="lede" data-reveal data-reveal-index="1">{category.description}</p>

    {
      brands.length > 0 && (
        <div class="cat-section__brands" data-reveal data-reveal-index="2">
          <p class="cat-section__brands-label">Brand disponibili</p>
          <ul>
            {brands.map((brand) => (
              <li>
                <Image src={brand.logo} alt={brand.name} height={40} loading="lazy" />
              </li>
            ))}
          </ul>
        </div>
      )
    }

    <a href="/contatti/" class="btn btn-primary" data-reveal data-reveal-index="3">
      Richiedi informazioni su {category.title.toLowerCase()}
    </a>
  </div>
</article>

<style>
  .cat-section {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2xl);
    align-items: center;
    padding-block: var(--space-2xl);
    border-bottom: 1px solid var(--color-border);
    scroll-margin-top: calc(var(--header-height) + 16px);
  }

  .cat-section:last-child {
    border-bottom: none;
  }

  .cat-section--reverse {
    direction: rtl;
  }

  .cat-section--reverse > * {
    direction: ltr;
  }

  .cat-section__media {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }

  .cat-section__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cat-section__copy .lede {
    margin-block: var(--space-sm) var(--space-md);
  }

  .cat-section__brands-label {
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-ink-faint);
    margin-bottom: var(--space-sm);
  }

  .cat-section__brands ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-lg);
  }

  .cat-section__brands li {
    display: grid;
    place-items: center;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.5em 0.85em;
    height: 56px;
  }

  .cat-section__brands :global(img) {
    max-height: 32px;
    width: auto;
    object-fit: contain;
  }

  @media (max-width: 900px) {
    .cat-section,
    .cat-section--reverse {
      grid-template-columns: 1fr;
      direction: ltr;
      gap: var(--space-md);
    }
  }
</style>
