---
import { categories } from '@data/categories';
---

<nav class="jump-nav" aria-label="Vai alla categoria di prodotto">
  <ul>
    {
      categories.map((cat) => (
        <li>
          <a href={`#${cat.slug}`}>{cat.title}</a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .jump-nav {
    position: sticky;
    top: var(--header-height);
    z-index: 20;
    background: var(--color-paper);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .jump-nav::-webkit-scrollbar {
    display: none;
  }

  .jump-nav ul {
    display: flex;
    gap: var(--space-xs);
    padding: var(--space-xs) var(--container-pad);
    width: max-content;
    min-width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
  }

  .jump-nav li {
    flex-shrink: 0;
  }

  .jump-nav a {
    display: block;
    padding: 0.6em 1em;
    min-height: 44px;
    font-weight: 650;
    color: var(--color-primary-dark);
    white-space: nowrap;
    background: var(--color-surface);
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-sm);
    transition: background-color var(--transition-base), color var(--transition-base);
  }

  .jump-nav a:hover {
    background: var(--color-primary-dark);
    color: #fff;
  }
</style>
