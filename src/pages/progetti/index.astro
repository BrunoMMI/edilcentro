---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/ui/PageHero.astro';
import Gallery from '@components/ui/Gallery.astro';
import CtaBanner from '@components/home/CtaBanner.astro';
import { projectImages, projectStyles } from '@data/projects';
import { SITE_URL } from '@/consts';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Progetti', url: '/progetti/' },
];

const hero = projectImages.find((p) => p.image.src.includes('render-bagno-marmo-07'))!;
const items = projectImages.map((p) => ({ image: p.image, alt: p.alt, group: p.style }));

const gallerySchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Progetti: render 3D di bagni Edil Centro',
  url: `${SITE_URL}/progetti/`,
  inLanguage: 'it-IT',
  about: projectStyles.map((s) => s.label),
  numberOfItems: projectImages.length,
};
---

<BaseLayout
  title="Progetti — Render 3D di bagni realizzati da Edil Centro"
  description="Galleria di render 3D fotorealistici di bagni realizzati da Edil Centro a Pace del Mela: stili marmo, cementato, geometrico, floreale ed effetto pennellata."
  path="/progetti/"
  breadcrumbs={breadcrumbs}
  image={hero.image.src}
  jsonLd={[gallerySchema]}
>
  <PageHero
    title="I nostri progetti"
    subtitle="Prima di iniziare i lavori, visualizza il risultato: una selezione di render fotorealistici realizzati su misura per ambientazioni bagno."
    breadcrumbs={breadcrumbs}
    image={hero.image}
    imageAlt={hero.alt}
  />

  <section class="section section--tight">
    <div class="container">
      <Gallery
        items={items}
        filters={projectStyles.map((s) => ({ slug: s.slug, label: s.label, description: s.description }))}
        showAll={false}
        filterLabel="Filtra i progetti per stile"
        lightboxLabel="Anteprima render del progetto"
      />
    </div>
  </section>

  <CtaBanner />
</BaseLayout>
