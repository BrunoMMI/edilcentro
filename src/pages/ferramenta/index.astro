---
import { Image } from 'astro:assets';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/ui/PageHero.astro';
import CtaBanner from '@components/home/CtaBanner.astro';
import { ferramentaSectors, ferramentaAdvantages } from '@data/ferramenta';
import { ferramentaLocation } from '@data/site';

import photo1 from '@assets/ferramenta/ferramenta-edil-centro-01.webp';
import photo2 from '@assets/ferramenta/ferramenta-edil-centro-03.webp';
import photo3 from '@assets/ferramenta/ferramenta-edil-centro-04.webp';
import photo4 from '@assets/ferramenta/ferramenta-edil-centro-05.webp';
import photo5 from '@assets/ferramenta/ferramenta-edil-centro-06.webp';
import photo6 from '@assets/ferramenta/ferramenta-edil-centro-07.webp';

const gallery = [photo1, photo2, photo3, photo4, photo5, photo6];

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Ferramenta', url: '/ferramenta/' },
];
---

<BaseLayout
  title="Ferramenta — Utensili e materiali per l'edilizia a Pace del Mela"
  description="Il reparto Ferramenta di Edil Centro a Pace del Mela: utensili, sistemi di fissaggio, vernici e materiali per l'edilizia. Indirizzo, telefono e orari di apertura."
  path="/ferramenta/"
  breadcrumbs={breadcrumbs}
>
  <PageHero
    eyebrow="Reparto dedicato"
    title="Ferramenta Edil Centro"
    subtitle="Da Edil Centro trovi tutto ciò che ti serve per costruire, riparare o rinnovare: uno staff competente pronto a consigliare la soluzione più adatta, in una sede dedicata a Pace del Mela."
    breadcrumbs={breadcrumbs}
  />

  <section class="section section--tight">
    <div class="container ferramenta-gallery">
      {
        gallery.map((img, index) => (
          <div class:list={['fg-item', { 'fg-item--wide': index === 0 }]} data-reveal data-reveal-index={index % 4}>
            <Image src={img} alt="Reparto Ferramenta Edil Centro a Pace del Mela" widths={[360, 560, 800]} sizes="(max-width: 900px) 45vw, 22vw" />
          </div>
        ))
      }
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Cosa trovi in ferramenta</p>
        <h2>Settori e categorie trattate</h2>
      </div>
      <div class="sectors-grid">
        {
          ferramentaSectors.map((sector, index) => (
            <div class="sector-card" data-reveal data-reveal-index={index % 4}>
              <h3>{sector.title}</h3>
              <p>{sector.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container ferramenta-info">
      <div data-reveal>
        <p class="eyebrow">Perché scegliere il nostro reparto ferramenta</p>
        <h2>Vantaggi</h2>
        <ul class="advantages">
          {ferramentaAdvantages.map((item) => <li>{item}</li>)}
        </ul>
      </div>

      <div class="ferramenta-card" data-reveal data-reveal-index="1">
        <h3>Contatti e orari</h3>
        <address>
          {ferramentaLocation.street}<br />
          {ferramentaLocation.cap} {ferramentaLocation.city} ({ferramentaLocation.province})
        </address>
        <ul class="ferramenta-hours">
          {
            ferramentaLocation.hours?.map((slot) => (
              <li>
                <span>{slot.days}</span>
                <span>{slot.time}</span>
              </li>
            ))
          }
        </ul>
        <div class="ferramenta-card__actions">
          <a href={ferramentaLocation.phoneHref} class="btn btn-primary">Chiama {ferramentaLocation.phone}</a>
          <a href={ferramentaLocation.mapsHref} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
            Come raggiungerci
          </a>
        </div>
      </div>
    </div>
  </section>

  <CtaBanner />
</BaseLayout>

<style>
  .ferramenta-gallery {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 200px;
    gap: var(--space-sm);
  }

  .fg-item {
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .fg-item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .fg-item--wide {
    grid-column: span 2;
    grid-row: span 2;
  }

  .sectors-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
  }

  .sector-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-md);
  }

  .sector-card h3 {
    font-size: 1.0625rem;
    margin-bottom: 0.4em;
  }

  .sector-card p {
    font-size: 0.875rem;
  }

  .ferramenta-info {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: var(--space-2xl);
    align-items: start;
  }

  .advantages {
    display: grid;
    gap: var(--space-sm);
    margin-top: var(--space-md);
  }

  .advantages li {
    padding-left: 1.75em;
    position: relative;
    color: var(--color-ink-soft);
  }

  .advantages li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .ferramenta-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
  }

  .ferramenta-card address {
    font-style: normal;
    color: var(--color-ink-soft);
    margin-block: var(--space-sm) var(--space-md);
  }

  .ferramenta-hours {
    display: grid;
    gap: 0.5em;
    margin-bottom: var(--space-lg);
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-sm);
  }

  .ferramenta-hours li {
    display: flex;
    justify-content: space-between;
    font-size: 0.9375rem;
    gap: var(--space-sm);
  }

  .ferramenta-hours li span:first-child {
    font-weight: 600;
    color: var(--color-ink);
  }

  .ferramenta-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6em;
  }

  @media (max-width: 900px) {
    .ferramenta-gallery {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 160px;
    }

    .sectors-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .ferramenta-info {
      grid-template-columns: 1fr;
    }
  }
</style>
