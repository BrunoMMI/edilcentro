---
import { Image } from 'astro:assets';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/ui/PageHero.astro';
import CtaBanner from '@components/home/CtaBanner.astro';
import { ferramentaSectors, ferramentaAdvantages } from '@data/ferramenta';
import { ferramentaLocation } from '@data/site';

import photo1 from '@assets/ferramenta/ferramenta-edil-centro-01.webp';
import photo0 from '@assets/ferramenta/ferramenta-edil-centro-02.webp';
import photo2 from '@assets/ferramenta/ferramenta-edil-centro-03.webp';
import photo3 from '@assets/ferramenta/ferramenta-edil-centro-04.webp';
import photo4 from '@assets/ferramenta/ferramenta-edil-centro-05.webp';
import photo5 from '@assets/ferramenta/ferramenta-edil-centro-06.webp';
import photo6 from '@assets/ferramenta/ferramenta-edil-centro-07.webp';

const gallery = [photo1, photo0, photo2, photo3, photo4, photo5, photo6];

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Ferramenta', url: '/ferramenta/' },
];
---

<BaseLayout
  title="Ferramenta — Utensili e materiali per l'edilizia a Pace del Mela"
  description="Il reparto Ferramenta di Edil Centro a Pace del Mela: utensili, sistemi di fissaggio, vernici e materiali per l'edilizia. Via Papa Giovanni XXIII 4, orari e telefono."
  path="/ferramenta/"
  breadcrumbs={breadcrumbs}
>
  <PageHero
    title="Ferramenta Edil Centro"
    subtitle="Tutto ciò che serve per costruire, riparare o rinnovare: uno staff competente pronto a consigliare la soluzione più adatta, in una sede dedicata a Pace del Mela."
    breadcrumbs={breadcrumbs}
    image={photo1}
    imageAlt="Reparto Ferramenta Edil Centro a Pace del Mela"
  />

  <section class="section section--tight">
    <div class="container ferramenta-gallery">
      {
        gallery.slice(1).map((img, index) => (
          <div class:list={['fg-item', { 'fg-item--wide': index === 0 }]} data-reveal="fade">
            <Image
              src={img}
              alt="Reparto Ferramenta Edil Centro a Pace del Mela, scaffali e articoli esposti"
              widths={[360, 560, 800]}
              sizes="(max-width: 900px) 50vw, 25vw"
            />
          </div>
        ))
      }
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2>Cosa trovi in ferramenta</h2>
      </div>
      <ul class="sectors-grid tile-grid">
        {
          ferramentaSectors.map((sector, index) => (
            <li class="sector-tile" data-reveal data-reveal-index={index % 4}>
              <h3>{sector.title}</h3>
              <p>{sector.description}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container ferramenta-info">
      <div data-reveal>
        <h2>Perché scegliere il nostro reparto</h2>
        <ul class="advantages">
          {ferramentaAdvantages.map((item) => <li>{item}</li>)}
        </ul>
      </div>

      <div class="ferramenta-card" data-reveal data-reveal-index="1">
        <h3>Contatti e orari</h3>
        <address>
          {ferramentaLocation.street}<br />
          {ferramentaLocation.cap} {ferramentaLocation.city} ({ferramentaLocation.province})
        </address>
        <ul class="ferramenta-hours">
          {
            ferramentaLocation.hours?.map((slot) => (
              <li>
                <span>{slot.days}</span>
                <span>{slot.time}</span>
              </li>
            ))
          }
        </ul>
        <div class="ferramenta-card__actions">
          <a href={ferramentaLocation.phoneHref} class="btn btn-primary">Chiama {ferramentaLocation.phone}</a>
          <a href={ferramentaLocation.mapsHref} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
            Come raggiungerci
          </a>
        </div>
      </div>
    </div>
  </section>

  <CtaBanner />
</BaseLayout>

<style>
  .ferramenta-gallery {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 200px;
    gap: var(--grout);
  }

  .fg-item {
    overflow: hidden;
  }

  .fg-item:last-child {
    grid-column: 1 / -1;
  }

  .fg-item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .fg-item--wide {
    grid-column: span 2;
    grid-row: span 2;
  }

  .sectors-grid {
    grid-template-columns: repeat(4, 1fr);
  }

  .sector-tile {
    padding: var(--space-md);
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  .sector-tile h3 {
    font-size: 1.1875rem;
    margin-bottom: var(--space-2xs);
  }

  .sector-tile p {
    font-size: 1rem;
  }

  .ferramenta-info {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    align-items: start;
  }

  .advantages {
    margin-top: var(--space-md);
  }

  .advantages li {
    position: relative;
    padding: var(--space-sm) 0 var(--space-sm) 2rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-ink-soft);
  }

  .advantages li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 1.35em;
    width: 14px;
    height: 8px;
    border-left: 3px solid var(--color-accent-dark);
    border-bottom: 3px solid var(--color-accent-dark);
    transform: rotate(-45deg);
  }

  .ferramenta-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding: var(--space-lg);
    background:
      radial-gradient(circle at 95% 5%, rgba(0, 152, 69, 0.45), transparent 45%),
      var(--color-primary-dark);
    border-radius: var(--radius-xl);
    color: #fff;
  }

  .ferramenta-card h3,
  .ferramenta-card address {
    color: #fff;
  }

  .ferramenta-card address {
    font-style: normal;
  }

  .ferramenta-hours li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0 var(--space-sm);
    padding-block: 0.5em;
    border-bottom: 1px solid rgba(255, 255, 255, 0.22);
    color: rgba(255, 255, 255, 0.88);
  }

  .ferramenta-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-xs);
  }

  .ferramenta-card .btn-primary {
    background: #fff;
    color: var(--color-primary-dark);
  }

  .ferramenta-card .btn-primary:hover {
    background: var(--color-accent-light);
  }

  .ferramenta-card .btn-secondary {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.7);
  }

  .ferramenta-card .btn-secondary:hover {
    background: #fff;
    color: var(--color-primary-dark);
  }

  @media (max-width: 1100px) {
    .sectors-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 900px) {
    .ferramenta-gallery {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 160px;
    }

    .ferramenta-info {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
  }

  @media (max-width: 560px) {
    .sectors-grid {
      grid-template-columns: 1fr;
    }

    .ferramenta-card {
      padding: var(--space-md);
    }
  }
</style>
