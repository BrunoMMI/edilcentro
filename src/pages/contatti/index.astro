---
import { Image } from 'astro:assets';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/ui/PageHero.astro';
import MapEmbed from '@components/contact/MapEmbed.astro';
import { mainLocation, ferramentaLocation, social } from '@data/site';
import { showroomPhoto } from '@data/showroom';
import ferramentaPhoto from '@assets/ferramenta/ferramenta-edil-centro-01.webp';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Contatti', url: '/contatti/' },
];

const heroPhoto = showroomPhoto('facciata-ceramiche');
const showroomFacade = showroomPhoto('facciata-sanitari-arredi');

const locations = [
  {
    ...mainLocation,
    tag: 'Showroom Edil Centro',
    description: 'Pavimenti, rivestimenti, sanitari, arredo bagno, rubinetteria e termoarredo.',
    photo: showroomFacade.image,
    photoAlt: showroomFacade.alt,
  },
  {
    ...ferramentaLocation,
    tag: 'Ferramenta Edil Centro',
    description: 'Utensili, sistemi di fissaggio e materiali per l’edilizia.',
    photo: ferramentaPhoto,
    photoAlt: 'Reparto Ferramenta Edil Centro a Pace del Mela',
  },
];
---

<BaseLayout
  title="Contatti — Showroom e Ferramenta a Pace del Mela"
  description="Come contattare Edil Centro: indirizzo, telefono, email e orari dello showroom (Via Giovanni Verga 4) e del reparto Ferramenta (Via Papa Giovanni XXIII 4) a Pace del Mela, Messina."
  path="/contatti/"
  breadcrumbs={breadcrumbs}
>
  <PageHero
    title="Contatti"
    subtitle="Due sedi a Pace del Mela per seguire ogni fase del tuo progetto: lo showroom di materiali e arredo bagno e il reparto Ferramenta."
    breadcrumbs={breadcrumbs}
    image={heroPhoto.image}
    imageAlt={heroPhoto.alt}
  />

  <section class="section section--tight">
    <div class="container contact-locations">
      {
        locations.map((loc, index) => (
          <article class="contact-location" data-reveal data-reveal-index={index}>
            <div class="contact-location__photo">
              <Image src={loc.photo} alt={loc.photoAlt} widths={[480, 720, 960]} sizes="(max-width: 900px) 100vw, 46vw" />
            </div>
            <div class="contact-location__body">
              <h2>{loc.tag}</h2>
              <p>{loc.description}</p>

              <dl class="contact-location__details">
                <div>
                  <dt>Indirizzo</dt>
                  <dd>
                    <address>
                      {loc.street}<br />
                      {loc.cap} {loc.city} ({loc.province})
                    </address>
                  </dd>
                </div>
                <div>
                  <dt>Telefono</dt>
                  <dd><a href={loc.phoneHref}>{loc.phone}</a></dd>
                </div>
                <div>
                  <dt>Cellulare</dt>
                  <dd><a href={loc.mobileHref}>{loc.mobile}</a></dd>
                </div>
                <div>
                  <dt>Email</dt>
                  <dd><a href={loc.emailHref}>{loc.email}</a></dd>
                </div>
                {loc.hours && (
                  <div>
                    <dt>Orari</dt>
                    <dd>
                      <ul class="contact-location__hours">
                        {loc.hours.map((slot) => (
                          <li>
                            <span>{slot.days}</span>
                            <span>{slot.time}</span>
                          </li>
                        ))}
                      </ul>
                    </dd>
                  </div>
                )}
              </dl>

              <div class="contact-location__actions">
                <a href={loc.phoneHref} class="btn btn-primary btn-sm">Chiama</a>
                <a href={loc.emailHref} class="btn btn-secondary btn-sm">Scrivi una email</a>
                <a href={loc.mapsHref} target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm">
                  Indicazioni stradali
                </a>
              </div>

              <MapEmbed query={loc.mapsQuery} label={loc.tag} />
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section section--alt">
    <div class="container social-block" data-reveal>
      <h2>Seguici sui social</h2>
      <p class="lede">Novità, progetti e prodotti anche su Facebook e Instagram.</p>
      <div class="social-block__links">
        <a href={social.facebook} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">Facebook</a>
        <a href={social.instagram} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">Instagram</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-locations {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--grout);
  }

  .contact-location {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }

  .contact-location__photo {
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .contact-location__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .contact-location__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding: var(--space-md);
    flex: 1;
  }

  .contact-location__details {
    display: grid;
    margin-block: var(--space-xs);
    border-top: 1px solid var(--color-border-strong);
  }

  .contact-location__details > div {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: var(--space-sm);
    padding-block: 0.75em;
    border-bottom: 1px solid var(--color-border);
  }

  .contact-location__details dt {
    font-weight: 700;
    color: var(--color-ink);
  }

  .contact-location__details address {
    font-style: normal;
  }

  .contact-location__details a {
    color: var(--color-primary);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .contact-location__hours li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0 var(--space-sm);
  }

  .contact-location__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-bottom: var(--space-xs);
  }

  .social-block {
    text-align: center;
  }

  .social-block .lede {
    margin: var(--space-sm) auto var(--space-md);
  }

  .social-block__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-xs);
  }

  @media (max-width: 900px) {
    .contact-locations {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .contact-location__details > div {
      grid-template-columns: 1fr;
      gap: 0.1em;
    }

    .contact-location__actions .btn {
      flex: 1 1 100%;
    }
  }
</style>
